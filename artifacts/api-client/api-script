# General Helper Functions. Any of these functions that communicate with the API should
# accept an auth token as an input. This greatly increases performance when dealing
# with multiple API calls.
retrieve_authentication_token() {
  local account="$1"
  local user="$2"
  # Allow hosts to be used instead of just users
  user=$(echo "$user" | sed -e "s/\//%2F/g")
  local api_key="$3"
  local url="${4:-$URL}"
  token="$(curl \
      --silent \
      --insecure \
      --header "Accept-Encoding: base64" \
      --request POST \
      --data "$api_key" \
      "$url/authn/$account/$user/authenticate")"
  echo "$token"
}

authenticate_user() {
  local account="$1"
  local user="$2"
  local password="$3"
  local url="${4:-$URL}"
  api_key="$(curl \
      --silent \
      --insecure \
      --user "$user:$password" \
      "$url/authn/$account/login")"
  token=$(retrieve_authentication_token "$account" "$user" "$api_key" "$url")
  echo "$token"
}

apply_policy() {
  local namespace="$1"
  local policy="$2"
  local token="$3"
  local method="${4:-POST}"
  curl --header "Authorization: Token token=\"$token\"" \
        --write-out "\n" \
        --insecure \
        --request "$method" \
        --data "$(cat $policy)" \
     "$master_url/policies/$ACCOUNT/policy/$namespace"
}

load_policy() {
  local namespace="$1"
  local policy="$2"
  local method="${3:-POST}"
  local
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  apply_policy "$namespace" "$policy" "$token" "$method"
}

set_variable() {
  local variable="$1"
  local value="$2"
  local token="$3"

  curl --header "Authorization: Token token=\"$token\"" \
        --insecure \
        --data "$value" \
        "$master_url/secrets/$ACCOUNT/variable/$variable"
}

apply_default_policy() {
  local environments='staging production'
  local numbers='1 2 3 4 5 6'
  local token="$token"

  apply_policy 'root' 'policy/modular/root.yml' "$token"

  for environment in $environments; do
    apply_policy "$environment" 'policy/modular/apps/applications.yml' "$token"
    for num in $numbers; do
      apply_policy "$environment/my-app-$num" 'policy/modular/apps/generic-application.yml' "$token"
      apply_policy "$environment/my-app-$num" 'policy/modular/services/pg-database.yml' "$token"
      apply_policy "$environment/my-app-$num" 'policy/modular/pg-entitlement.yml' "$token"
    done
  done
}

apply_default_values() {
  local token="$1"
  local environments='staging production'
  local numbers='1 2 3 4 5 6'

  for environment in $environments; do
    for num in $numbers; do
      set_variable "$environment/my-app-$num/postgres-database/url" "$environment.my-app-$num.staging.mycompany-postgres.com/my-app" "$token"
      set_variable "$environment/my-app-$num/postgres-database/port" "5432" "$token"
      set_variable "$environment/my-app-$num/postgres-database/username" "my-app-$num" "$token"
      set_variable "$environment/my-app-$num/postgres-database/password" "secret-p@ssword-$environment-my-app-$num" "$token"
    done
  done
}

fetch_secrets() {
  local variables="$1"
  local token="$2"
  curl --header "Authorization: Token token=\"$token\"" \
        --write-out "\n" \
        --insecure \
        --request GET \
        "$master_url/secrets?variable_ids=$variables"
}

# The following functions are called directly from the CLI using flags. These functions
# need to retrieve a token to be passed to the functions interacting directly with
# the Conjur API
load_default_policy() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_default_policy "$token"
}

delete_policy() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_policy 'delete_branch/first-level' 'policy/delete_policy/delete.yml' "$token" 'PATCH'
}

set_secret() {
  local variable_path="$1"
  local variable_value="$2"
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  set_variable "$variable_path" "$variable_value" "$token"
}

load_default_values() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_default_values "$token"
}

retrieve_variables() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$URL")
  secrets="$ACCOUNT:variable:staging/my-app-1/postgres-database/url,$ACCOUNT:variable:staging/my-app-1/postgres-database/port,$ACCOUNT:variable:staging/my-app-1/postgres-database/username,$ACCOUNT:variable:staging/my-app-1/postgres-database/password"
  fetch_secrets $secrets "$token" | jq .
}

load_policy_and_set_variables() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_default_policy "$token"
  apply_default_values "$token"
}

view_roles() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$URL")
  curl --header "Authorization: Token token=\"$token\"" \
        --write-out "\n" \
        --insecure \
        --request GET \
        "$URL/resources/$ACCOUNT" | jq .
}

view_policy_members() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$URL")
  curl --header "Authorization: Token token=\"$token\"" \
        --write-out "\n" \
        --insecure \
        --request GET \
        "$master_url/roles/$ACCOUNT/policy/production?members" | jq .
}

set_thousand_variables() {
  local i="$1"
  local value="$2"
  local token="$3"
  local urls=""
  for j in $(seq 1 1000); do
    urls="$master_url/secrets/$ACCOUNT/variable/staging-$i/myapp/secret-$j $urls"
  done
  curl --header "Authorization: Token token=\"$token\"" \
        --parallel \
        --parallel-immediate \
        --parallel-max "$(nproc --all)" \
        --insecure \
        --data "$value" \
        $urls
}

load_large_policy_and_secrets() {
  local auth_token
  local iterations
  # Each iteration sets 1k secret values
  iterations=150
  auth_token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_policy 'root' 'policy/large-policy/root.yml' "$auth_token"
  for i in $(seq 1 $iterations)
  do
    apply_policy "staging-$i" 'policy/large-policy/variables.yml' "$auth_token"
    # Periodically refresh auth token
    if [ $((i%10)) = 0 ]; then
      auth_token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
    fi
    auth_token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
    set_thousand_variables "$i" "super-secret-value!!!" "$auth_token"
    echo "loaded $i of $iterations"
  done
}

enable_seed_service() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_policy 'root' 'policy/seed-service/default.yml' "$token"
  apply_policy 'conjur' 'policy/seed-service/seed.yml' "$token"
}

rotate_api_key() {
  local user="$1"
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  curl --header "Authorization: Token token=\"$token\"" \
        --write-out "\n" \
        --insecure \
        --request PUT \
        "$master_url/authn/$ACCOUNT/api_key?role=user:$user"
}

rotate_multiple_host_api_keys() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  local responses=""
  for host in "$@"; do
    response=$(curl --header "Authorization: Token token=\"$token\"" \
                    --insecure \
                    --request PUT \
                    --silent \
                    "$master_url/authn/$ACCOUNT/api_key?role=host:$host")
    responses="$responses $response"
  done
  echo "$responses"
}

create_aws_issuer() {
  local name="$1"
  local access_key_id="$2"
  local secret_access_key="$3"
  local token response body status
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  # Current versions require 'data' to reference Conjur variables holding the credentials, which Conjur
  # resolves and AWS-format-validates at create time.
  local key_id_ref='dynamic-secrets/aws-access-key-id'
  local secret_key_ref='dynamic-secrets/aws-secret-access-key'

  apply_policy 'root' 'policy/dynamic-secrets/issuer-credentials.yml' "$token" > /dev/null
  set_variable "$key_id_ref" "$access_key_id" "$token" > /dev/null
  set_variable "$secret_key_ref" "$secret_access_key" "$token" > /dev/null

  response=$(post_issuer "$token" "{
         \"id\": \"${name}\",
         \"max_ttl\": 3600,
         \"type\": \"aws\",
         \"data\": {
           \"access_key_id_secret_ref\": { \"id\": \"${key_id_ref}\" },
           \"secret_access_key_secret_ref\": { \"id\": \"${secret_key_ref}\" }
         }
       }")
  body=$(echo "${response}" | head -n -1)
  status=$(echo "${response}" | tail -n 1)

  # Older versions only accept the credentials inline and answer the reference form with exactly this 422.
  # Fall back for that one answer only; any other failure is still an error.
  if [ "$status" = "422" ] && echo "${body}" | grep -q 'access_key_id is a required parameter'; then
    echo "This version does not accept credential references; creating the issuer with inline credentials" >&2
    response=$(post_issuer "$token" "{
         \"id\": \"${name}\",
         \"max_ttl\": 3600,
         \"type\": \"aws\",
         \"data\": {
           \"access_key_id\": \"${access_key_id}\",
           \"secret_access_key\": \"${secret_access_key}\"
         }
       }")
    body=$(echo "${response}" | head -n -1)
    status=$(echo "${response}" | tail -n 1)
  fi

  if [ "$status" -ne 201 ]; then
    echo "Error creating issuer: $status"
    echo "${body}" | jq
    exit 1
  fi
  echo "${body}" | jq
}

# POST an issuer definition; prints the response body, then the HTTP status on its own line.
post_issuer() {
  local token="$1"
  local json="$2"
  curl --header "Authorization: Token token=\"$token\"" \
       --header "Content-Type: application/json" \
       --silent \
       --write-out "\n%{http_code}" \
       --insecure \
       --request POST \
       --data "$json" \
       "$master_url/api/issuers/demo"
}

delete_aws_issuer() {
  set -x
  local name="$1"
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  curl --header "Authorization: Token token=\"$token\"" \
       --silent \
       --write-out "\n" \
       --insecure \
       --request DELETE \
       --verbose \
       "$master_url/api/issuers/demo/$name"
}

list_issuers() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  response=$(curl --header "Authorization: Token token=\"$token\"" \
       --silent \
       --write-out "\n%{http_code}" \
       --insecure \
       "$URL/api/issuers/demo")
  body=$(echo "${response}" | head -n -1)
  status=$(echo "${response}" | tail -n 1)

  if [ "$status" -ne 200 ]; then
    echo "Error listing issuers: $status"
    echo "${body}" | jq
    exit 1
  fi
  echo "${body}" | jq
}

get_dynamic_secret() {
  local secret_id="$1"
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  curl --header "Authorization: Token token=\"$token\"" \
       --write-out "\n" \
       --insecure \
       --silent \
       --request GET \
       "$URL/api/secrets/demo/variable/data/dynamic/${secret_id}" | \
       jq '.data.secret_access_key = "****" | .data.session_token = "*****"'
}

# Strict checks used by bin/upgrade-test
# Unlike most helpers above, these exit 1 with a message on any unexpected result, so that an
# upgrade that silently breaks issuers, dynamic secrets or certificate authentication fails the test.

# Fetch one issuer and print only its stable fields (no created_at / modified_at).
# Reads from $URL: the follower by default, the leader with --against-master.
fetch_issuer_stable() {
  local name="$1"
  local token response body status
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  response=$(curl --header "Authorization: Token token=\"$token\"" \
       --silent \
       --write-out "\n%{http_code}" \
       --insecure \
       "$URL/api/issuers/$ACCOUNT/$name")
  body=$(echo "${response}" | head -n -1)
  status=$(echo "${response}" | tail -n 1)

  if [ "$status" != "200" ]; then
    echo "Error reading issuer '$name' from $URL: HTTP $status" >&2
    echo "${body}" >&2
    exit 1
  fi
  echo "${body}" | jq -S '{id, account, type, max_ttl, data}'
}

get_issuer() {
  fetch_issuer_stable "$1"
}

# Compare an issuer's stable fields with a snapshot taken before the upgrade.
check_issuer() {
  local name="$1"
  local snapshot="$2"
  local current
  if [ ! -s "$snapshot" ]; then
    echo "Snapshot file '$snapshot' is missing or empty" >&2
    exit 1
  fi
  current=$(fetch_issuer_stable "$name")
  if [ "$current" != "$(jq -S . "$snapshot")" ]; then
    echo "Issuer '$name' at $URL differs from the snapshot taken before the upgrade:" >&2
    echo "--- before" >&2
    jq -S . "$snapshot" >&2
    echo "--- now" >&2
    echo "$current" >&2
    exit 1
  fi
  echo "Issuer '$name' at $URL matches the snapshot"
}

load_dynamic_policy() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_policy 'root' 'policy/dynamic-secrets/dynamic-variable.yml' "$token"
}

# A dynamic secret is only minted by calling the cloud provider, and the test has fake credentials, so
# there are two acceptable outcomes:
#   200  the secret was issued (real credentials were supplied)
#   422  "Failed to create the dynamic secret", i.e. Conjur found the issuer, decrypted it and resolved
#        its credential references, then the cloud provider rejected the fake keys
# Everything else means something earlier in that chain is broken after the upgrade (404 route or flag
# missing, 405 database privileges, 422 issuer not found / data key invalid, 5xx).
check_dynamic_secret() {
  local name="$1"
  local token response body status
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")

  response=$(curl --header "Authorization: Token token=\"$token\"" \
       --silent \
       --write-out "\n%{http_code}" \
       --insecure \
       "$URL/api/secrets/$ACCOUNT/variable/data/dynamic/$name")
  body=$(echo "${response}" | head -n -1)
  status=$(echo "${response}" | tail -n 1)

  case "$status" in
    200)
      echo "Dynamic secret '$name' at $URL was issued"
      ;;
    422)
      if echo "${body}" | grep -q 'Failed to create the dynamic secret'; then
        echo "Dynamic secret '$name' at $URL reached the cloud call (fake credentials were rejected, as expected)"
      else
        echo "Dynamic secret '$name' at $URL: HTTP 422 for a reason other than the cloud call" >&2
        echo "${body}" >&2
        exit 1
      fi
      ;;
    *)
      echo "Dynamic secret '$name' at $URL: unexpected HTTP $status" >&2
      echo "${body}" >&2
      exit 1
      ;;
  esac
}

load_cert_auth_policy() {
  local token
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  apply_policy 'root' 'policy/authn-cert/upgrade.yml' "$token"
}

# Set a variable to the exact contents of a file. Passing a multi-line value (a PEM) as a command line
# argument does not work here: the dispatch below uses an unquoted eval, which splits it into words.
# The stored size is compared with the file's size, because a silently truncated CA looks like a
# product failure ("Credential validation failed") when it is a test failure.
set_variable_from_file() {
  local variable="$1"
  local file="$2"
  local token status stored_bytes file_bytes encoded
  if [ ! -s "$file" ]; then
    echo "File '$file' is missing or empty" >&2
    exit 1
  fi
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  encoded=$(echo "$variable" | sed -e 's/\//%2F/g')

  status=$(curl --header "Authorization: Token token=\"$token\"" \
       --silent --output /dev/null --write-out "%{http_code}" \
       --insecure \
       --data-binary "@$file" \
       "$master_url/secrets/$ACCOUNT/variable/$encoded")
  if [ "$status" != "201" ]; then
    echo "Error setting variable '$variable' from '$file': HTTP $status" >&2
    exit 1
  fi

  stored_bytes=$(curl --header "Authorization: Token token=\"$token\"" \
       --silent --insecure \
       "$master_url/secrets/$ACCOUNT/variable/$encoded" | wc -c)
  file_bytes=$(wc -c < "$file")
  if [ "$stored_bytes" -ne "$file_bytes" ]; then
    echo "Variable '$variable' holds $stored_bytes bytes but '$file' has $file_bytes" >&2
    exit 1
  fi
  echo "Variable '$variable' set from '$file' ($stored_bytes bytes)"
}

# Authenticate a host with a client certificate (mutual TLS) through the leader. The certificate is
# presented in the TLS handshake, so this goes to the leader's load balancer, which passes TLS through.
# Standbys do not run the authenticator, and a follower accepts the certificate only once the authenticator
# list has been applied on it.
cert_auth_status() {
  local host="$1"
  local cert="$2"
  local key="$3"
  local service="${4:-upgrade}"
  local encoded_host
  encoded_host=$(echo "host/$host" | sed -e 's/\//%2F/g')
  curl --silent --insecure \
       --cert "$cert" --key "$key" \
       --request POST \
       --output /tmp/cert-auth-token \
       --write-out "%{http_code}" \
       "$master_url/authn-cert/$service/$ACCOUNT/$encoded_host/authenticate"
}

cert_auth() {
  local status
  status=$(cert_auth_status "$@")
  if [ "$status" != "200" ]; then
    echo "Certificate authentication as '$1' failed: HTTP $status" >&2
    head -c 300 /tmp/cert-auth-token >&2
    echo >&2
    exit 1
  fi
  if [ ! -s /tmp/cert-auth-token ]; then
    echo "Certificate authentication as '$1' returned HTTP 200 but no token" >&2
    exit 1
  fi
  echo "Certificate authentication as '$1' succeeded"
}

# Negative check: the request must fail with exactly the given status (e.g. 401 for a certificate signed
# by a CA Conjur does not trust). Without it, a broken trust check would pass the check above unnoticed.
cert_auth_expect() {
  local expected="$1"; shift
  local status
  status=$(cert_auth_status "$@")
  if [ "$status" != "$expected" ]; then
    echo "Certificate authentication as '$1' returned HTTP $status, expected $expected" >&2
    exit 1
  fi
  echo "Certificate authentication as '$1' returned HTTP $status, as expected"
}

# Capability probes
# bin/upgrade-test uses these to decide whether the FROM version can do something at all (older ones have no
# certificate authentication, or only the older inline form of AWS issuers). They ask the running leader, so
# they work on development builds whose version number says nothing, and need no version table to maintain.

# Exit 0 if the leader has the certificate authenticator installed, 1 if not.
supports_cert_auth() {
  local body
  body=$(curl --silent --insecure "$master_url/authenticators") || return 1
  echo "$body" | jq -e '.installed | index("authn-cert")' > /dev/null 2>&1
}

# Exit 0 if the leader serves the issuers API, 1 if not.
# Listing issuers cannot answer this: it needs a permission that only exists once the first issuer has been
# created, so on a fresh cluster it returns 403 even though the feature is on. Creating an issuer with an
# empty body is rejected by the issuers API's own validation with 400, which a missing route (feature flag
# off) cannot produce, and nothing is created.
supports_issuers() {
  local token status
  token=$(authenticate_user "$ACCOUNT" "$USER" "$PASSWORD" "$master_url")
  status=$(curl --header "Authorization: Token token=\"$token\"" \
       --header "Content-Type: application/json" \
       --silent --output /dev/null --write-out "%{http_code}" --insecure \
       --request POST --data '{}' \
       "$master_url/api/issuers/$ACCOUNT")
  [ "$status" = "400" ]
}

# -- End functions called directly from CLI --

follower_url='http://conjur-follower.mycompany.local'
master_url='https://conjur-master.mycompany.local'
URL=$follower_url
ACCOUNT='demo'
USER='admin'
PASSWORD='MySecretP@ss1'
cmd=''

while true ; do
  case "$1" in
    -a | --account ) shift ; ACCOUNT=$1 ; shift ;;
    -u | --user ) shift ; USER=$1 ; shift ;;
    -p | --password ) shift ; PASSWORD=$1 ; shift ;;
    --follower-url ) shift ; follower_url=$1 ; shift ;;
    --leader-url ) shift ; master_url=$1 ; shift ;;
    --authenticate-user ) shift ; cmd="authenticate_user $ACCOUNT $USER $PASSWORD" ;;
    -h | --help ) _print_help ;;
    --patch-policy ) shift ; cmd="load_policy $1 $2 PATCH" ; shift ; shift ;;
    --load-policy ) shift ; cmd="load_policy $1 $2" ; shift ; shift ;;
    --load-sample-policy-and-values ) shift ; cmd="load_policy_and_set_variables" ;;
    --load-sample-policy ) shift ; cmd='load_default_policy' ;;
    --load-large-secrets-sample ) shift ; cmd='load_large_policy_and_secrets' ;;
    --delete-policy ) shift; cmd='delete_policy' ;;
    --set-secrets ) shift ; cmd='load_default_values' ;;
    --set-secret-value ) shift ; cmd="set_secret $1 $2"; shift ; shift ;;
    --against-master ) shift ; URL=$master_url ;;
    --fetch-secrets ) shift ; cmd="retrieve_variables" ;;
    --view-roles ) cmd="view_roles" ; shift ;;
    --rotate-api-key ) shift ; cmd="rotate_api_key $1" ; shift ;;
    --rotate-multiple-host-api-keys ) shift ; cmd="rotate_multiple_host_api_keys $1" ; shift ;;
    --enable-seed-service ) shift ; cmd='enable_seed_service' ;;
    --create-aws-issuer ) shift ; cmd="create_aws_issuer $1 $2 $3"; shift; shift; shift ;;
    --delete-aws-issuer ) shift ; cmd="delete_aws_issuer $1"; shift ;;
    --list-issuers ) shift ; cmd="list_issuers" ;;
    --get-dynamic-secret ) shift ; cmd="get_dynamic_secret $1" ; shift ;;
    --supports-cert-auth ) shift ; cmd="supports_cert_auth" ;;
    --supports-issuers ) shift ; cmd="supports_issuers" ;;
    --get-issuer ) shift ; cmd="get_issuer $1" ; shift ;;
    --check-issuer ) shift ; cmd="check_issuer $1 $2" ; shift ; shift ;;
    --load-dynamic-policy ) shift ; cmd="load_dynamic_policy" ;;
    --check-dynamic-secret ) shift ; cmd="check_dynamic_secret $1" ; shift ;;
    --load-cert-auth-policy ) shift ; cmd="load_cert_auth_policy" ;;
    --set-variable-from-file ) shift ; cmd="set_variable_from_file $1 $2" ; shift ; shift ;;
    --cert-auth )
      # <host> <cert-file> <key-file> [service-id]. The service id is optional, so it is only taken when
      # the next word is not another option.
      shift ; cmd="cert_auth $1 $2 $3" ; shift ; shift ; shift
      if [ -n "$1" ] && [ "${1#-}" = "$1" ]; then cmd="$cmd $1"; shift; fi ;;
    --cert-auth-expect )
      # <status> <host> <cert-file> <key-file> [service-id]
      shift ; cmd="cert_auth_expect $1 $2 $3 $4" ; shift ; shift ; shift ; shift
      if [ -n "$1" ] && [ "${1#-}" = "$1" ]; then cmd="$cmd $1"; shift; fi ;;
     * ) if [ -z "$1" ]; then break; else echo "$1 is not a valid option"; exit 1; fi;;
  esac
done

eval $cmd
