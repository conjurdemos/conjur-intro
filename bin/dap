#!/usr/bin/env bash

set -e

# Always work from repo root directory
cd "$(dirname ${0})/..";

source ./bin/utils.sh

# Make sure .env envvars are available
dotenv > /dev/null 2>&1 || true

# Registry prefix of the conjur-appliance image (see appliance_registry in bin/utils.sh)
export APPLIANCE_REGISTRY="$(appliance_registry)"

CONJUR_MASTER_PORT=${CONJUR_MASTER_PORT:-443}
CONJUR_FOLLOWER_PORT=${CONJUR_FOLLOWER_PORT:-450}
CONJUR_K8S_FOLLOWER_PORT=${CONJUR_K8S_FOLLOWER_PORT:-451}
_admin_password="MySecretP@ss1"

function _print_help {
  cat << EOF

A tool that provides a variety of DAP lifecycle workflows.

Synopsis: bin/dap [command options]

Usage: bin/dap [options]:

    --create-backup                                           Creates a backup (Requires configured master).

    --dry-run                                                 Print configuration commands with executing.

    --enable-auto-failover                                    Configures Master cluster with auto-failover
                                                                (Requires configured master and standbys).

    --generate-dh                                             Don't mount pre-generated DH params into the
                                                                appliance containers (will cause a _lot_ more
                                                                CPU consumption).

    --h, --help                                               Shows this help message.

    --import-custom-certificates                              Imports pre-generated 3rd-party certificates
                                                                (Requires configured master).

    --promote-standby                                         Stops the current master and promotes a standby
                                                                (Requires configured standbys and no auto-failover).

    --provision-follower                                      Configures follower behind a Layer 7 load balancer
                                                                (Requires configured master).

    --provision-k8s-follower                                  Configures follower inside kubernetes cluster ran by kind
                                                                (Requires configured master).

    --provision-csi-provider                                  Configures Conjur CSI provider inside kubernetes cluster ran by kind
                                                                (Requires configured master).

    --provision-secrets-provider                              Configures Conjur Secrets Provider inside kubernetes cluster ran by kind
                                                                (Requires configured master).

    --provision-secretless-broker                             Configures Secretless Broker as a sidecar inside kubernetes cluster ran by kind
                                                                (Requires configured master).

    --provision-cert-auth                                     Configures certificate authentication: generates a CA and a client certificate
                                                                (Requires configured master, appliance 5.22 or newer).

    --provision-keycloak                                      Starts Keycloak and configures an OIDC authenticator for it
                                                                (Requires configured master).

    --provision-jwt                                           Configures a JWT authenticator that accepts tokens signed with a generated key;
                                                                no token issuer is needed (Requires configured master).

    --jwt-token <host>                                        Prints a token for the host, signed with the key from --provision-jwt.

    --provision-ldap-jit                                      Starts an LDAP server and configures the LDAP authenticator with just-in-time
                                                                user provisioning (Requires configured master, appliance 5.24 or newer).

    --provision-ldap-sync                                     Starts an LDAP server and imports its users and groups into Conjur with LDAP Sync
                                                                (Requires configured master).

    --provision-master                                        Configures a DAP Master with account `demo` and
                                                                password `MySecretP@ss1` behind a Layer 4 load
                                                                balancer.

    --provision-standbys                                      Deploys and configures two standbys (Requires
                                                                configured master).

    --reenroll-failed-leader <old-leader-id> <new-leader-id>  Performs a re-enroll of the previous master
                                                                following a failover event.

    --restore-from-backup                                     Restores a master from backup|Requires a previously
                                                                created backup.

    --rotate-custom-certificates                              Regenerates custom certificates and applies the new
                                                                certificates to each node.

    --standby-count <count>                                   Number of Standbys to deploy (defaults to 2).

    --stop                                                    Stops all containers and cleans up cached files.

    --trigger-failover                                        Stops current master (Requires an auto-failover
                                                                cluster).

    --trust-follower-proxy                                    Adds Follower load balancer as a trusted proxy
                                                                (Requires a configured follower).

    --upgrade-master <version>                                Restores master from backup (Requires configured
                                                                master).

    --wait-for-master                                         Blocks until the Master is healthy.

    --version <version>                                       Version of DAP to use (defaults to latest build).

    --k8s-follower-version <version>                          Version of K8S-Follower to use (defaults to latest build).

    --wait-for-master                                         Waits for Conjur Master to become healthy.

    --follower-to-master-connection <on/off>                  Pauses or unpauses follower connection to master.
                                                                (Requires a configured master).


EOF
  exit
}

function _set_master_multi_node_proxy_config {
  cat << EOF > files/haproxy/master/haproxy.cfg
global
  daemon
  maxconn 256
  log-send-hostname

defaults
  mode tcp
  timeout connect 5000ms
  timeout client  50000ms
  timeout server  50000ms

#
# Peform SSL Pass-Through to proxy HTTPS requests to DAP
#
frontend www
  mode tcp
  bind *:443
  option tcplog
  default_backend www-backend

#
# Peform SSL pass-through to proxy Postgres TCP requests from standbys/followers to DAP Master
#
frontend postgres
  mode tcp
  bind *:5432
  option tcplog
  default_backend postgres-backend

#
# Peform SSL pass-through to proxy Syslog TCP requests from followers to DAP Master
#
frontend syslog
  mode tcp
  bind *:1999
  option tcplog
  default_backend syslog-backend

#
# Performs Layer 4 proxy
# Uses DAP's HTTP health endpoint to determine master
#
backend www-backend
  mode tcp
  balance roundrobin
  option httpchk GET /health
  server conjur-master-1 conjur-master-1.mycompany.local:443 check port 443 check-ssl ca-file /etc/ssl/certs/ca.pem
$(_standby_backend_www_lines)

#
# Performs Layer 4 proxy
# Uses DAP's HTTP health endpoint to determine master
#
backend postgres-backend
  mode tcp
  balance roundrobin
  option httpchk GET /health
  server conjur-master-1 conjur-master-1.mycompany.local:5432 check port 443 check-ssl ca-file /etc/ssl/certs/ca.pem
$(_standby_backend_postgres_lines)

#
# Performs Layer 4 proxy
# Uses DAP's HTTP health endpoint to determine master
#
backend syslog-backend
  mode tcp
  balance roundrobin
  option httpchk GET /health
  server conjur-master-1 conjur-master-1.mycompany.local:1999 check port 443 check-ssl ca-file /etc/ssl/certs/ca.pem
$(_standby_backend_syslog_lines)

#
# Enables HAProxy's UI for debugging
#
listen stats
  mode http
  bind *:7000
  stats enable
  stats uri /
EOF
}

_standby_backend_www_lines() {
  declare -a standby_servers

  # The identifier for the Leader is 1, so we start at 2 for Standbys
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    standby_servers+=("  server conjur-master-$i conjur-master-$i.mycompany.local:443 check port 443 check-ssl ca-file /etc/ssl/certs/ca.pem")
  done

  printf '%s' "$(IFS=$'\n' ; echo "${standby_servers[*]}")"
}

_standby_backend_postgres_lines() {
  declare -a standby_servers

  # The identifier for the Leader is 1, so we start at 2 for Standbys
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    standby_servers+=("  server conjur-master-$i conjur-master-$i.mycompany.local:5432 check port 443 check-ssl ca-file /etc/ssl/certs/ca.pem")
  done

  printf '%s' "$(IFS=$'\n' ; echo "${standby_servers[*]}")"
}

_standby_backend_syslog_lines() {
    declare -a standby_servers

  # The identifier for the Leader is 1, so we start at 2 for Standbys
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    standby_servers+=("  server conjur-master-$i conjur-master-$i.mycompany.local:1999 check port 443 check-ssl ca-file /etc/ssl/certs/ca.pem")
  done

  printf '%s' "$(IFS=$'\n' ; echo "${standby_servers[*]}")"
}

function _set_master_single_node_proxy_config {
  cp files/haproxy/master/single/haproxy.cfg files/haproxy/master/haproxy.cfg
}

function _run {
  local _all_args=("$@")
  local _node_name=$1
  local _args=("${_all_args[@]:1}")

  echo "Running Command (on $_node_name): docker exec cyberark-dap $_args"

  if [[ $DRY_RUN = false ]]; then
    docker compose exec -T $_node_name bash -c "
      $_args
    "
  fi
}

# Each command will be executed with KUBE_OPTS environment variable
# which is defined to point to the k8s-follower-orchestrator cluster.
# The KUBE_OPTS variable should be then used in the command to interact with the k8s-follower-orchestrator cluster.
# For example:
# _run_in_kind "kubectl \$KUBE_OPTS get pods"
function _run_in_kind {
  local _args=("$@")

  if [[ $DRY_RUN = false ]]; then
    # shellcheck disable=SC2128
    docker compose exec -T k8s-follower-orchestrator ash -c "
      API_SERVER_URL=\$(kind get --name conjur-intro-k8s-follower kubeconfig | grep server | awk '{print \$2}' | sed 's/0.0.0.0/host.docker.internal/'); \
      KUBE_OPTS=\"--insecure-skip-tls-verify --server=\$API_SERVER_URL --context kind-conjur-intro-k8s-follower\"; \
      $_args
    "
  fi
}

function _start_master {
  if [[ $DRY_RUN = false ]]; then

    if [[ "$PULL_IMAGES" = "true" ]]; then
      docker compose pull
    fi

    docker compose up -d --no-deps conjur-master-1.mycompany.local
  fi
}

function _start_l7_load_balancer {
  if [[ $DRY_RUN = false ]]; then
    docker compose up -d --no-deps conjur-follower.mycompany.local
  fi
}

function _configure_master {
  # Copy DH Param
  docker cp files/dhparam.pem "$(docker compose ps -q conjur-master-1.mycompany.local)":${DHPATH}/dhparam.pem

  _cmd="evoke configure master"
  _cmd="$_cmd --accept-eula"
  _cmd="$_cmd --hostname conjur-master.mycompany.local"
  _cmd="$_cmd --master-altnames conjur-master-1.mycompany.local,$(_standby_altnames)"
  _cmd="$_cmd --admin-password $_admin_password"
  _cmd="$_cmd demo"

  _run conjur-master-1.mycompany.local \
    "$_cmd"
}

function _setup_standby {
  local _standby_number=$1

  docker compose rm --stop --force "conjur-master-$_standby_number.mycompany.local"
  docker compose up --no-deps --detach "conjur-master-$_standby_number.mycompany.local"

  # Generate a Seed File
  _run conjur-master-1.mycompany.local \
    "evoke seed standby conjur-master-$_standby_number.mycompany.local conjur-master-1.mycompany.local > /opt/cyberark/dap/seeds/standby-seed-$_standby_number.tar"

  # Unpack and Configure
  if _mke_enabled; then 
    _run conjur-master-$_standby_number.mycompany.local \
      "evoke unpack seed /opt/cyberark/dap/seeds/standby-seed-$_standby_number.tar && evoke keys exec -m /secrets/master.key -- evoke configure standby"
  else
    _run conjur-master-$_standby_number.mycompany.local \
      "evoke unpack seed /opt/cyberark/dap/seeds/standby-seed-$_standby_number.tar && evoke configure standby"
  fi

  if _mke_enabled; then 
    _run conjur-master-$_standby_number.mycompany.local \
      "cat /secrets/master.key | evoke keys unlock -"
  fi

}

function _start_standby_synchronization {
  _run conjur-master-1.mycompany.local \
    "evoke replication sync start"
}

function _setup_follower {

  docker compose rm --stop --force conjur-follower-1.mycompany.local
  docker compose up --no-deps --detach conjur-follower-1.mycompany.local

  if _mke_enabled; then
    # Need to decrypt the keys before seeding because certificate issue requires them to be decrypted
    _run conjur-master-1.mycompany.local \
      "cat /secrets/master.key | evoke keys decrypt-all -"
  fi

  # Generate Seed file
  _run conjur-master-1.mycompany.local \
    "evoke seed follower conjur-follower.mycompany.local > /opt/cyberark/dap/seeds/follower-seed.tar"

  if _mke_enabled; then 
    # Re-encrypt master after seeding our follower
    _run conjur-master-1.mycompany.local \
      "cat /secrets/master.key | evoke keys encrypt -"
    _run conjur-master-1.mycompany.local \
      "cat /secrets/master.key | evoke keys unlock -"

    _run conjur-master-1.mycompany.local \
      "evoke wait" # Allow leaders services to become healthy before configuring follower
  fi

  # Unpack and Configure
  _run conjur-follower-1.mycompany.local \
    "evoke unpack seed /opt/cyberark/dap/seeds/follower-seed.tar && evoke configure follower"

  if _mke_enabled; then 
    _run conjur-follower-1.mycompany.local \
      "cat /secrets/master.key | evoke keys encrypt -"

    _run conjur-follower-1.mycompany.local \
      "cat /secrets/master.key | evoke keys unlock -"
  fi

  # Copy certs for HAProxy. Use the conjur.pem/conjur.key symlinks (resolve
  # to the client-facing/external cert under cert-separated appliance
  # builds, or the flat cert on pre-cert-separation builds) rather than the
  # hardcoded hostname-named files, which no longer exist once cert
  # separation migrates certs under ssl/external/.
  _run conjur-follower-1.mycompany.local \
    "[ /opt/conjur/etc/ssl/conjur.pem -ef /opt/conjur/etc/ssl/conjur-follower.mycompany.local.pem ] || cp /opt/conjur/etc/ssl/conjur.pem /opt/conjur/etc/ssl/conjur-follower.mycompany.local.pem"
  _run conjur-follower-1.mycompany.local \
    "cp /opt/conjur/etc/ssl/conjur.key /opt/conjur/etc/ssl/conjur-follower.mycompany.local.pem.key"
  _run conjur-follower-1.mycompany.local \
    "chown 99:99 /opt/conjur/etc/ssl/conjur-follower.mycompany.local.pem /opt/conjur/etc/ssl/conjur-follower.mycompany.local.pem.key"

  _start_l7_load_balancer
  echo "DAP Follower instance available at: 'https://localhost:${CONJUR_FOLLOWER_PORT}'"
}

function _setup_k8s_follower {
  # Create a kubeconfig file to be used by the k8s-follower-orchestrator cluster
  touch kubeconfig
  # Setup k8s-follower-orchestrator cluster
  docker compose build \
    --build-arg K8S_FOLLOWER_TAG="$K8S_FOLLOWER_TAG" \
    --build-arg CONJUR_K8S_FOLLOWER_PORT="$CONJUR_K8S_FOLLOWER_PORT" \
    k8s-follower-orchestrator
  docker compose up -d --no-deps k8s-follower-orchestrator

  # Wait a little bit to create k8s-follower-orchestrator cluster
  SECONDS=0
  TIMEOUT=600
  while true; do
    if _run_in_kind "kubectl \$KUBE_OPTS get nodes | grep -q \"Ready\"" &> /dev/null; then
      echo "The conjur-intro-k8s-follower cluster is created."
      break
    else
      echo "Waiting for the conjur-intro-k8s-follower cluster to be created..."
      sleep 1
    fi
    if [ $SECONDS -ge $TIMEOUT ]; then
        echo "Timeout after waiting for 10 minutes. The conjur-intro-k8s-follower cluster is not created."
        echo "Printing logs from k8s-follower-orchestrator container:"
        docker logs conjur-intro-k8s-follower-orchestrator-1
        echo "Printing logs from docker logs k8s-follower-control-plane container:"
        docker logs conjur-intro-k8s-follower-control-plane
        exit 1
      fi
  done

  # Discover Kubernetes resources
  jwks=$(_run_in_kind "kubectl \$KUBE_OPTS get --raw \$(kubectl \$KUBE_OPTS get --raw /.well-known/openid-configuration | jq -r '.jwks_uri')")
  policy_value="{\"type\":\"jwks\",\"value\":$jwks}"

  # Define the JWT Authenticator in Conjur
  bin/cli conjur policy load -b root -f artifacts/k8s-follower-orchestrator/jwt-authenticator-webservice-policy.yaml
  # Populate the policy variables
  curl -k -X POST \
    -H "$(bin/cli conjur authenticate -H | tail -n1)" \
    --data "$policy_value" \
    "https://localhost/secrets/demo/variable/conjur%2Fauthn-jwt%2Fdev-cluster%2Fpublic-keys"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster/issuer -v https://kubernetes.default.svc.cluster.local
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster/token-app-property -v "sub"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster/identity-path -v apps
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster/audience -v "https://host.docker.internal"
  # Enable the JWT Authenticator in Conjur
  _append_conjur_authenticator "authn-jwt/dev-cluster"

  # Pull the Conjur Kubernetes Follower images on host,
  # tag them as docker.io images as load into k8s-follower-orchestrator cluster
  pull_k8s_follower_images

  # Deploy the Conjur Kubernetes Follower
  _run_in_kind "kubectl \$KUBE_OPTS apply -f /manifests/operator"
  bin/cli conjur policy load -f artifacts/k8s-follower-orchestrator/seed-generation-policy.yaml -b root
  bin/cli conjur policy load -f artifacts/k8s-follower-orchestrator/conjur-kubernetes-follower-policy.yaml -b root

  # Ensure certs are up to date. The follower bootstraps trust with the leader
  # over its external/client-facing HTTPS endpoint, so use the "conjur.pem"
  # symlink, which resolves to the external cert under cert-separated
  # appliance builds (ssl/external/<host>.pem) or the flat cert on
  # pre-cert-separation builds. The configmap key must stay
  # "conjur-master.mycompany.local.pem" -- it's referenced by name in the
  # ConjurFollower CR generated from artifacts/k8s-follower-orchestrator/Dockerfile.
  docker cp "$(docker compose ps -q conjur-master-1.mycompany.local)":/opt/conjur/etc/ssl/. ./system/haproxy/certs
  # On pre-cert-separation builds conjur.pem is an absolute symlink, which
  # dangles once copied out of the container; use the file it points at.
  _run_in_kind "cert=/etc/ssl/certs/conjur.pem; [ -r \$cert ] || cert=/etc/ssl/certs/conjur-master.mycompany.local.pem; kubectl \$KUBE_OPTS create configmap -n cyberark-conjur conjur-cert --from-file=conjur-master.mycompany.local.pem=\$cert"

  # Apply manifest with Conjur Follower
  _run_in_kind "kubectl \$KUBE_OPTS apply -f /manifests/samples"

  echo "Waiting for the conjur-follower deployment to be running..."
  # This kind cluster is often provisioned alongside several other
  # concurrent k8s-follower clusters on shared CI infra (e.g. parallel
  # nightly load-test stages), so pod scheduling/startup can be slower
  # than on a quiet host. Use a more generous timeout than a single
  # local run would need, and dump diagnostics before failing so a
  # genuine failure (as opposed to a slow-but-healthy rollout) is easy
  # to tell apart from contention after the fact.
  if ! _run_in_kind "kubectl \$KUBE_OPTS wait --namespace=cyberark-conjur --for=condition=available --timeout=10m deployment/conjur-follower"; then
    echo "Timed out waiting for the conjur-follower deployment. Dumping diagnostics:"
    _run_in_kind "kubectl \$KUBE_OPTS get pods -n cyberark-conjur -o wide" || true
    _run_in_kind "kubectl \$KUBE_OPTS describe deployment/conjur-follower -n cyberark-conjur" || true
    _run_in_kind "kubectl \$KUBE_OPTS get events -n cyberark-conjur --sort-by=.lastTimestamp" || true
    _run_in_kind "kubectl \$KUBE_OPTS logs -n cyberark-conjur --all-containers --prefix --tail=200 deployment/conjur-follower" || true
    _run_in_kind "kubectl \$KUBE_OPTS logs -n cyberark-conjur --all-containers --prefix --tail=200 --previous deployment/conjur-follower" || true
    exit 1
  fi

  # Deploy NodePort that will expose Conjur Follower endpoint
  _run_in_kind "kubectl \$KUBE_OPTS apply -f conjur-follower-node-port.yaml"

  echo "K8S Follower instance deployed and available at https://localhost:${CONJUR_K8S_FOLLOWER_PORT}"
}

function pull_k8s_follower_images {
  local images=(
    "conjur-kubernetes-follower-operator"
    "conjur-kubernetes-follower-configurator"
    "conjur-kubernetes-follower-conjur"
    "conjur-kubernetes-follower-info"
    "conjur-kubernetes-follower-nginx"
    "conjur-kubernetes-follower-postgres"
    "conjur-kubernetes-follower-syslog-ng"
    "conjur-kubernetes-follower-failover-rebaser"
    "conjur-kubernetes-follower-ephemeral-secrets"
    "conjur-kubernetes-follower-authenticator"
  )

  for image in "${images[@]}"; do
    img="registry.tld/cyberark/${image}:${K8S_FOLLOWER_TAG}"
    img_without_registry="cyberark/${image}:${K8S_FOLLOWER_TAG}"

    # Skip the pull entirely if the image is already present locally (e.g.
    # a locally-built image tagged to match ${K8S_FOLLOWER_TAG}).
    #
    # Otherwise, try to pull the image, but continue if it fails with "not
    # found". This allows older Followers to be deployed when they do not
    # have images introduced in later releases (e.g. failover-rebaser,
    # ephemeral-secrets, etc.)
    if [[ -n "$(docker images -q "${img}" 2> /dev/null)" ]]; then
      echo "Using local image ${img}"
    elif ! docker pull "${img}" 2>&1 | grep -q "not found"; then
      echo "Successfully pulled ${img}"
    else
      echo "Warning: Failed to pull ${img} (not found), continuing anyway..."
      continue
    fi

    docker tag "${img}" "${img_without_registry}"
    _run_in_kind "mkdir -p /tmp/cyberark"

    # The operator's Deployment manifest (built via bin/build-raw with a
    # registry.tld/... IMG) keeps the full registry prefix, unlike the
    # follower images' manifest (conjur_v1_conjurfollower.yaml), which
    # references bare cyberark/... names. imagePullPolicy: Never requires an
    # exact reference match, so import the operator image under both names;
    # the extra import is a no-op for the other images (same layers, just
    # tagged twice).
    _run_in_kind "docker save \"${img}\" -o /tmp/${image}-with-registry.tar"
    _run_in_kind "docker exec --privileged -i conjur-intro-k8s-follower-worker ctr --namespace=k8s.io images import - < /tmp/${image}-with-registry.tar"

    _run_in_kind "docker save \"${img_without_registry}\" -o /tmp/${img_without_registry}.tar"
    _run_in_kind "docker exec --privileged -i conjur-intro-k8s-follower-worker ctr --namespace=k8s.io images import - < /tmp/${img_without_registry}.tar"
  done
}

function _setup_secrets_provider {
  touch kubeconfig
  docker compose rm --stop --force secrets-provider-orchestrator
  docker compose build secrets-provider-orchestrator
  docker compose up --no-deps --detach secrets-provider-orchestrator

  # Wait until we get a response from the Kubernetes API that the node is ready
  SECONDS=0
  TIMEOUT=300
  while true; do
    NODE_OUTPUT="$(docker compose exec -T secrets-provider-orchestrator bash -c 'kubectl get nodes' 2>/dev/null || true)"
    if echo "$NODE_OUTPUT" | grep -q "conjur-intro-secrets-provider-control-plane"; then
      echo "The conjur-intro-secrets-provider cluster is created."
      break
    else
      echo "Waiting for the conjur-intro-secrets-provider cluster to be created..."
      sleep 1
    fi
    if [ $SECONDS -ge $TIMEOUT ]; then
      echo "Timeout after waiting for 5 minutes. The conjur-intro-secrets-provider cluster is not created or node name is incorrect."
      docker compose logs secrets-provider-orchestrator
      exit 1
    fi
  done

  # Define and enable the JWT Authenticator in Conjur
  bin/cli conjur policy load -b root -f artifacts/k8s-secrets-provider/jwt-authenticator-webservice-policy.yaml
  jwks=$(docker compose exec -T secrets-provider-orchestrator bash -c "kubectl get --raw \$(kubectl get --raw /.well-known/openid-configuration | jq -r '.jwks_uri')")
  policy_value="{\"type\":\"jwks\",\"value\":$jwks}"
  curl -k -X POST \
    -H "$(bin/cli conjur authenticate -H | tail -n1)" \
    --data "$policy_value" \
    "https://localhost/secrets/demo/variable/conjur%2Fauthn-jwt%2Fdev-cluster-sp%2Fpublic-keys"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sp/issuer -v https://kubernetes.default.svc.cluster.local
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sp/token-app-property -v "sub"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sp/identity-path -v apps
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sp/audience -v "conjur"
  _append_conjur_authenticator "authn-jwt/dev-cluster-sp"

  # Prepare the test app namespace and service account
  export TEST_APP_NAMESPACE="test-app"
  export TEST_APP_SA="test-app-sa"
  docker compose exec -T secrets-provider-orchestrator bash -c "kubectl create namespace $TEST_APP_NAMESPACE"
  docker compose exec -T secrets-provider-orchestrator bash -c "kubectl create serviceaccount $TEST_APP_SA -n $TEST_APP_NAMESPACE"

  # Prep helm repos
  docker compose exec -T secrets-provider-orchestrator bash -c "helm repo add cyberark --insecure-skip-tls-verify https://cyberark.github.io/helm-charts"
  docker compose exec -T secrets-provider-orchestrator bash -c "helm repo update"

  # Install the Conjur ConfigMap
  docker compose exec -T secrets-provider-orchestrator bash -c "helm install cluster-prep cyberark/conjur-config-cluster-prep \
    --insecure-skip-tls-verify \
    --namespace cyberark-conjur-jwt \
    --create-namespace \
    --set conjur.account=demo \
    --set conjur.applianceUrl=https://conjur-master.mycompany.local \
    --set conjur.certificateBase64=$(cat ./system/haproxy/certs/conjur.pem | base64) \
    --set authnK8s.authenticatorID=dev-cluster-sp \
    --set authnK8s.clusterRole.create=false \
    --set authnK8s.serviceAccount.create=false"

  # Install the namespace prep chart
  docker compose exec -T secrets-provider-orchestrator bash -c "helm install namespace-prep cyberark/conjur-config-namespace-prep \
    --insecure-skip-tls-verify \
    --namespace $TEST_APP_NAMESPACE \
    --set conjurConfigMap.authnMethod=authn-jwt \
    --set authnK8s.goldenConfigMap=conjur-configmap \
    --set authnK8s.namespace=cyberark-conjur-jwt \
    --set authnRoleBinding.create=false"
  
  # Load the test-app policy into Conjur and set some example variables
  bin/cli conjur policy load -f artifacts/k8s-secrets-provider/test-app-policy.yaml -b root
  bin/cli conjur variable set -i db-credentials/url -v "https://some-db.example.com:5432"
  bin/cli conjur variable set -i db-credentials/username -v "db-user"
  bin/cli conjur variable set -i db-credentials/password -v "db-password"

  # Deploy the test app with Secrets Provier
  docker compose exec -T secrets-provider-orchestrator bash -c "kubectl apply -f /artifacts/k8s-secrets-provider/manifests/test_app.yaml \
    --namespace \"$TEST_APP_NAMESPACE\""
}

function _setup_csi_provider {
  touch kubeconfig
  docker compose rm --stop --force csi-provider-orchestrator
  docker compose build csi-provider-orchestrator
  docker compose up --no-deps --detach csi-provider-orchestrator

  # Wait until we get a response from the Kubernetes API that the node is ready
  SECONDS=0
  TIMEOUT=300
  while true; do
    NODE_OUTPUT="$(docker compose exec -T csi-provider-orchestrator bash -c 'kubectl get nodes' 2>/dev/null || true)"
    if echo "$NODE_OUTPUT" | grep -q "conjur-intro-csi-provider-control-plane"; then
      echo "The conjur-intro-csi-provider cluster is created."
      break
    else
      echo "Waiting for the conjur-intro-csi-provider cluster to be created..."
      sleep 1
    fi
    if [ $SECONDS -ge $TIMEOUT ]; then
      echo "Timeout after waiting for 5 minutes. The conjur-intro-csi-provider cluster is not created or node name is incorrect."
      docker compose logs csi-provider-orchestrator
      exit 1
    fi
  done

  # Define and enable the JWT Authenticator in Conjur
  bin/cli conjur policy load -b root -f artifacts/k8s-csi-provider/jwt-authenticator-webservice-policy.yaml
  jwks=$(docker compose exec -T csi-provider-orchestrator bash -c "kubectl get --raw \$(kubectl get --raw /.well-known/openid-configuration | jq -r '.jwks_uri')")
  policy_value="{\"type\":\"jwks\",\"value\":$jwks}"
  curl -k -X POST \
    -H "$(bin/cli conjur authenticate -H | tail -n1)" \
    --data "$policy_value" \
    "https://localhost/secrets/demo/variable/conjur%2Fauthn-jwt%2Fdev-cluster-csi%2Fpublic-keys"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-csi/issuer -v https://kubernetes.default.svc.cluster.local
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-csi/token-app-property -v "sub"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-csi/identity-path -v apps
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-csi/audience -v "conjur"
  _append_conjur_authenticator "authn-jwt/dev-cluster-csi"


  # Prep helm repos
  docker compose exec -T csi-provider-orchestrator bash -c "helm repo add cyberark --insecure-skip-tls-verify https://cyberark.github.io/helm-charts"
  docker compose exec -T csi-provider-orchestrator bash -c "helm repo add secrets-store-csi-driver --insecure-skip-tls-verify https://kubernetes-sigs.github.io/secrets-store-csi-driver/charts"
  docker compose exec -T csi-provider-orchestrator bash -c "helm repo update"

  # Install the Secrets Store CSI Driver 
  docker compose exec -T csi-provider-orchestrator bash -c "helm install csi-secrets-store \
      secrets-store-csi-driver/secrets-store-csi-driver \
      --namespace csi \
      --create-namespace \
      --insecure-skip-tls-verify \
      --set \"linux.providersDir=/var/run/secrets-store-csi-providers\" \
      --set syncSecret.enabled=\"true\" \
      --set \"tokenRequests[0].audience=conjur\"
    "

  # Load the test-app policy into Conjur and set some example variables
  bin/cli conjur policy load -f artifacts/k8s-csi-provider/test-app-policy.yaml -b root
  bin/cli conjur variable set -i db-credentials/url -v "https://some-db.example.com:5432"
  bin/cli conjur variable set -i db-credentials/username -v "db-user"
  bin/cli conjur variable set -i db-credentials/password -v "db-password"

  # Install the Conjur Provider
  docker compose exec -T csi-provider-orchestrator bash -c "helm install --debug conjur-provider \
      cyberark/conjur-k8s-csi-provider \
      --wait \
      --namespace csi \
      --insecure-skip-tls-verify \
      --set daemonSet.image.repo=\"cyberark/conjur-k8s-csi-provider\" \
      --set daemonSet.image.tag=\"latest\"
    "

  # Deploy a test app
  export TEST_APP_NAMESPACE="test-app"
  export TEST_APP_SA="test-app-sa"
  docker compose exec -T csi-provider-orchestrator bash -c "kubectl create namespace $TEST_APP_NAMESPACE"
  docker compose exec -T csi-provider-orchestrator bash -c "kubectl create serviceaccount $TEST_APP_SA -n $TEST_APP_NAMESPACE"

  docker compose exec -T csi-provider-orchestrator bash -c "helm install test-app /artifacts/k8s-csi-provider/helm/test-app \
    --wait --timeout \"1m\" \
    --namespace \"$TEST_APP_NAMESPACE\" \
    --set serviceAccount.name=\"$TEST_APP_SA\" \
    --set conjur.configurationVersion=0.2.0 \
    --set conjur.sslCertificate=\"$(cat ./system/haproxy/certs/conjur.pem)\" \
    --set conjur.applianceUrl=\"https://conjur-master.mycompany.local\" \
    --set conjur.account=\"demo\" \
    --set conjur.authnId=\"dev-cluster-csi\" \
    --set conjur.secrets=\"- \"relative/path/fileA.txt\": \"db-credentials/url\"
- \"relative/path/fileB.txt\": \"db-credentials/username\"
- \"relative/path/fileC.txt\": \"db-credentials/password\"\"
"
}

function _setup_secretless_broker {
  touch kubeconfig
  docker compose rm --stop --force secretless-broker-orchestrator
  docker compose build secretless-broker-orchestrator
  docker compose up --no-deps --detach secretless-broker-orchestrator

  # Wait until the KinD node appears as Ready
  SECONDS=0
  TIMEOUT=300
  while true; do
    NODE_OUTPUT="$(docker compose exec -T secretless-broker-orchestrator bash -c 'kubectl get nodes' 2>/dev/null || true)"
    if echo "$NODE_OUTPUT" | grep -q "conjur-intro-secretless-broker-control-plane"; then
      echo "The conjur-intro-secretless-broker cluster is created."
      break
    else
      echo "Waiting for the conjur-intro-secretless-broker cluster to be created..."
      sleep 1
    fi
    if [ $SECONDS -ge $TIMEOUT ]; then
      echo "Timeout after waiting for 5 minutes. The conjur-intro-secretless-broker cluster is not created or node name is incorrect."
      docker compose logs secretless-broker-orchestrator
      exit 1
    fi
  done

  # Define and enable the JWT Authenticator in Conjur
  bin/cli conjur policy load -b root -f artifacts/k8s-secretless-broker/jwt-authenticator-webservice-policy.yaml
  jwks=$(docker compose exec -T secretless-broker-orchestrator bash -c "kubectl get --raw \$(kubectl get --raw /.well-known/openid-configuration | jq -r '.jwks_uri')")
  policy_value="{\"type\":\"jwks\",\"value\":$jwks}"
  curl -k -X POST \
    -H "$(bin/cli conjur authenticate -H | tail -n1)" \
    --data "$policy_value" \
    "https://localhost/secrets/demo/variable/conjur%2Fauthn-jwt%2Fdev-cluster-sb%2Fpublic-keys"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sb/issuer -v https://kubernetes.default.svc.cluster.local
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sb/token-app-property -v "sub"
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sb/identity-path -v apps
  bin/cli conjur variable set -i conjur/authn-jwt/dev-cluster-sb/audience -v "conjur"
  _append_conjur_authenticator "authn-jwt/dev-cluster-sb"

  # Prepare the test app namespace and service account
  export TEST_APP_NAMESPACE="test-app"
  export TEST_APP_SA="test-app-sa"
  docker compose exec -T secretless-broker-orchestrator bash -c "kubectl create namespace $TEST_APP_NAMESPACE"

  # Prep helm repos
  docker compose exec -T secretless-broker-orchestrator bash -c "helm repo add cyberark --insecure-skip-tls-verify https://cyberark.github.io/helm-charts"
  docker compose exec -T secretless-broker-orchestrator bash -c "helm repo update"

  # Install the Conjur connection ConfigMap via cluster-prep chart
  docker compose exec -T secretless-broker-orchestrator bash -c "helm install cluster-prep cyberark/conjur-config-cluster-prep \
    --insecure-skip-tls-verify \
    --namespace cyberark-conjur-jwt \
    --create-namespace \
    --set conjur.account=demo \
    --set conjur.applianceUrl=https://conjur-master.mycompany.local \
    --set conjur.certificateBase64=$(cat ./system/haproxy/certs/conjur.pem | base64) \
    --set authnK8s.authenticatorID=dev-cluster-sb \
    --set authnK8s.clusterRole.create=false \
    --set authnK8s.serviceAccount.create=false"

  # Install the namespace prep chart so the conjur-connect ConfigMap is available in test-app
  docker compose exec -T secretless-broker-orchestrator bash -c "helm install namespace-prep cyberark/conjur-config-namespace-prep \
    --insecure-skip-tls-verify \
    --namespace $TEST_APP_NAMESPACE \
    --set conjurConfigMap.authnMethod=authn-jwt \
    --set authnK8s.goldenConfigMap=conjur-configmap \
    --set authnK8s.namespace=cyberark-conjur-jwt \
    --set authnRoleBinding.create=false"

  # Load the test-app policy and set credential variables
  bin/cli conjur policy load -f artifacts/k8s-secretless-broker/test-app-policy.yaml -b root
  bin/cli conjur variable set -i db-credentials/username -v "db-user"
  bin/cli conjur variable set -i db-credentials/password -v "db-password"

  # Deploy the secretless-broker ConfigMap and test app
  docker compose exec -T secretless-broker-orchestrator bash -c "kubectl apply -f /artifacts/k8s-secretless-broker/manifests/secretless-config.yaml \
    --namespace \"$TEST_APP_NAMESPACE\""
  docker compose exec -T secretless-broker-orchestrator bash -c "kubectl apply -f /artifacts/k8s-secretless-broker/manifests/test_app.yaml \
    --namespace \"$TEST_APP_NAMESPACE\""

  # Wait for the test app deployment to become available
  docker compose exec -T secretless-broker-orchestrator bash -c \
    "kubectl wait --for=condition=available --timeout=5m deployment/test-app --namespace \"$TEST_APP_NAMESPACE\""

  # Validate that secretless-broker is intercepting connections
  echo "Validating secretless-broker connectivity..."
  docker compose exec -T secretless-broker-orchestrator bash -c \
    "kubectl exec -n $TEST_APP_NAMESPACE deploy/test-app -c test-app -- nc -z localhost 5432"
  echo "Secretless Broker is accepting connections on localhost:5432."
}

#
## Failover & Promotion
#
function _perform_promotion {
  # Stop current master
  if [[ $DRY_RUN = false ]]; then
    docker compose stop conjur-master-1.mycompany.local
  fi

  # Promote Standby to Master
  _run conjur-master-2.mycompany.local \
    "evoke role promote"

  # Repoint Standby to updated Master
  _run conjur-master-3.mycompany.local \
    "evoke replication rebase conjur-master-2.mycompany.local"
}

function deploy_proxy {
  _set_master_single_node_proxy_config
  # Copy Conjur generated certificates to HAProxy
  mkdir -p ./system/haproxy/certs
  docker cp "$(docker compose ps -q conjur-master-1.mycompany.local)":/opt/conjur/etc/ssl/. ./system/haproxy/certs
  docker compose up -d --no-deps conjur-master.mycompany.local
  _verify_proxy_network
}

function _verify_proxy_network {
  local proxy_running
  proxy_running="$(docker compose ps --status running -q conjur-master.mycompany.local)"

  if [[ -z "$proxy_running" ]]; then
    echo ""
    echo "ERROR: The HAProxy container failed to start."
    echo "This is usually caused by host port ${CONJUR_MASTER_PORT:-443} already being"
    echo "in use by another process or container."
    echo ""
    echo "To use a different host port, set CONJUR_MASTER_PORT in a .env file:"
    echo "  echo 'CONJUR_MASTER_PORT=8443' > .env"
    echo ""
    exit 1
  fi
}

function _setup_keycloak() {
  source ./artifacts/keycloak/keycloak-functions.sh

  docker compose up -d --no-deps --wait keycloak

  # Fetch keycloak certificate
  _run conjur-master-1.mycompany.local '/oauth/keycloak/scripts/fetch-certificate'

  create_keycloak_users

  echo "Setting keycloak policy and variable values in Conjur"

  bin/cli conjur policy load -b root -f ./artifacts/keycloak/oidc-policy.yml

  bin/cli conjur variable set -i "conjur/authn-oidc/keycloak/provider-uri" -v "https://keycloak:8443/realms/master"
  bin/cli conjur variable set -i "conjur/authn-oidc/keycloak/id-token-user-property" -v "preferred_username"
  bin/cli conjur variable set -i "conjur/authn-oidc/keycloak/client-id" -v "conjurClient"
  bin/cli conjur variable set -i "conjur/authn-oidc/keycloak/client-secret" -v "1234"
  bin/cli conjur variable set -i "conjur/authn-oidc/keycloak/claim-mapping" -v "email"
  bin/cli conjur variable set -i "conjur/authn-oidc/keycloak/redirect_uri" -v "http://127.0.0.1:8888/callback"

  bin/cli conjur variable set -i "test-variable" -v "test-secret"

  # The ID-token login (POST /authn-oidc/keycloak/demo/authenticate) of this authenticator is switched off in
  # current appliances; without the flag that endpoint answers 404. The reload that follows applies it.
  _run conjur-master-1.mycompany.local 'grep -q "^CONJUR_FEATURE_OIDC_AUTHENTICATOR_V1_ENABLED=" /opt/conjur/etc/possum.conf || echo "CONJUR_FEATURE_OIDC_AUTHENTICATOR_V1_ENABLED=true" >> /opt/conjur/etc/possum.conf'

  _append_conjur_authenticator "authn-oidc/keycloak"
  # _append_conjur_authenticator returns early, without a reload, when the authenticator is already enabled
  _run conjur-master-1.mycompany.local 'sv reload conjur'
  _wait_for_master
  _trust_keycloak_on_other_nodes
  _sync_authenticators_to_other_nodes

  echo "Keycloak admin console is available at: http://localhost:7777/admin"
  echo "Log in with a Keycloak ID token (users alice/alice and bob.somebody/bob; request it inside the Docker network):"
  echo "  ID_TOKEN=\$(docker compose exec -T keycloak curl -sk -d grant_type=password -d client_id=conjurClient -d client_secret=1234 \\"
  echo "    -d username=alice -d password=alice -d scope=openid https://keycloak:8443/realms/master/protocol/openid-connect/token | jq -r .id_token)"
  echo "  curl -k -H 'Accept-Encoding: base64' --data-urlencode \"id_token=\${ID_TOKEN}\" https://localhost:${CONJUR_MASTER_PORT}/authn-oidc/keycloak/demo/authenticate"
}

# Prints the version of the appliance running on the leader, for example 5.24.1-1113.10.0.
# The image tag cannot be used: tags such as `5.0-stable` or a local `test` are not versions.
function _leader_appliance_version {
  docker compose exec -T conjur-master-1.mycompany.local cat /opt/conjur/etc/VERSION 2> /dev/null | tr -d '\r\n'
}

# True if the dotted version $1 is at least $2 (compares the numeric prefix only).
# Unreleased builds report 0.0.dev (or 0.0.dev-<timestamp>-<sha>); they contain the newest code, so they pass.
function _version_at_least {
  local have=${1%%-*} want=$2
  if [[ "${have}" == 0.0.dev ]]; then
    return 0
  fi
  [[ "$(printf '%s\n%s\n' "$want" "$have" | sort -V | head -1)" == "$want" ]]
}

# Usage: _ldap_curl <token> <curl args...>; talks to the leader's published port.
function _ldap_curl {
  local token=$1; shift
  curl -sk -H "Authorization: Token token=\"${token}\"" "$@"
}

# Prints an admin token. Stops with a message when the leader does not answer, so that the callers do not go on with an
# empty token, or (JWT, certificate authentication) leave key material behind.
function _admin_token {
  local url="https://localhost:${CONJUR_MASTER_PORT}" key token=""
  key=$(curl -sfk --user "admin:${_admin_password}" "${url}/authn/demo/login") || key=""
  if [[ -n "${key}" ]]; then
    token=$(curl -sfk -H "Accept-Encoding: base64" --data "${key}" "${url}/authn/demo/admin/authenticate") || token=""
  fi
  if [[ -z "${token}" ]]; then
    echo "Could not get an admin token from ${url}; is the leader running and healthy?" >&2
    return 1
  fi
  printf '%s' "${token}"
}

# Generates the LDAP server certificate and the CA that Conjur trusts, once, into tmp/ldap-certs.
function _generate_ldap_certs {
  local out=./tmp/ldap-certs
  if [[ -f "${out}/ldap-server.cert.pem" ]]; then
    return
  fi
  echo "Generating the LDAP server certificate..."
  mkdir -p "${out}"
  ( cd tools/simple-certificates && ./generate_certificates 1 ldap-server > /dev/null 2>&1 )
  local certs=tools/simple-certificates/certificates
  cp "${certs}/ca-chain.cert.pem" "${out}/ca-chain.cert.pem"
  cp "${certs}/nodes/ldap-server.mycompany.local/ldap-server.mycompany.local.cert.pem" "${out}/ldap-server.cert.pem"
  cp "${certs}/nodes/ldap-server.mycompany.local/ldap-server.mycompany.local.key.pem" "${out}/ldap-server.key.pem"
  # The server drops to its own user and reads these files through a bind mount, which keeps the host owner and mode,
  # so they have to be readable by others. The CA is throwaway and tmp/ is git-ignored.
  chmod 644 "${out}"/*.pem
}

function _start_ldap_server {
  _generate_ldap_certs
  echo "Starting the LDAP server (the first start takes about a minute)..."
  docker compose up -d --no-deps --wait ldap-server
}

# Logs in as an LDAP user; prints the HTTP status. Usage: _ldap_login_status <service> <user> <password>
function _ldap_login_status {
  curl -sk -o /dev/null -w '%{http_code}' --user "$2:$3" "https://localhost:${CONJUR_MASTER_PORT}/authn-ldap/$1/demo/login"
}

function _setup_ldap_jit() {
  local min_version=5.24.0 version
  version=$(_leader_appliance_version)
  if [[ -z "${version}" ]]; then
    echo "Cannot read the appliance version from conjur-master-1; run --provision-master first."
    exit 1
  fi
  if ! _version_at_least "${version}" "${min_version}"; then
    echo "LDAP just-in-time provisioning needs appliance ${min_version} or newer; this leader runs ${version}."
    exit 1
  fi

  _start_ldap_server

  local token url="https://localhost:${CONJUR_MASTER_PORT}"
  token=$(_admin_token)

  echo "Loading the LDAP JIT policy..."
  _ldap_curl "${token}" -X PATCH --data-binary @artifacts/ldap/jit-policy.yml "${url}/policies/demo/policy/root" > /dev/null

  echo "Storing the LDAP CA certificate and the bind password..."
  _ldap_curl "${token}" --data-binary @tmp/ldap-certs/ca-chain.cert.pem \
    "${url}/secrets/demo/variable/conjur%2Fauthn-ldap%2Fjit%2Ftls-ca-cert" > /dev/null
  _ldap_curl "${token}" --data 'ldapsecret' \
    "${url}/secrets/demo/variable/conjur%2Fauthn-ldap%2Fjit%2Fbind-password" > /dev/null

  echo "Mapping the LDAP group 'devs' to the Conjur group 'dev-team'..."
  _ldap_curl "${token}" -H 'Content-Type: application/json' --data '{"roles":["group:dev-team"]}' \
    "${url}/authn-ldap/jit/demo/groups/cn%3Ddevs%2Cou%3Dgroups%2Cdc%3Dconjur%2Cdc%3Dnet" > /dev/null

  _append_conjur_authenticator "authn-ldap/jit"
  _sync_authenticators_to_other_nodes

  echo "Checking: alice logs in with her LDAP password..."
  local status
  status=$(_ldap_login_status jit alice alice)
  if [[ "${status}" != "200" ]]; then
    echo "LDAP JIT check failed: alice's login returned HTTP ${status}."
    exit 1
  fi

  cat << EOF

LDAP just-in-time provisioning is set up (authenticator authn-ldap/jit).

  LDAP server:  ldaps://ldap-server:636   base dc=conjur,dc=net   admin password ldapsecret
  LDAP users:   alice/alice (group devs), bob/bob, charles/charles
  Mapping:      LDAP group devs -> Conjur group dev-team

Users are created in Conjur under 'ldap-users' on their first login. Try it:
  curl -k --user alice:<password> ${url}/authn-ldap/jit/demo/login
bob and charles have no mapping yet, so their logins are refused (401) until you add one.
EOF
}

# Starts the ldap-sync service on the leader and waits until it answers.
# The appliance ships it switched off ("normally down"), so it is not running after a restart of the leader.
function _start_ldap_sync_service {
  echo "Starting the ldap-sync service on conjur-master-1..."
  if ! _run conjur-master-1.mycompany.local 'sv -w 60 start /etc/service/conjur/ldap-sync' > /dev/null; then
    echo "Could not start the ldap-sync service on conjur-master-1; is the leader running and healthy?"
    exit 1
  fi
  local i
  for i in $(seq 1 30); do
    if _run conjur-master-1.mycompany.local 'curl -sf -m 3 localhost:7944/version' > /dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  echo "The ldap-sync service did not answer on port 7944 within a minute."
  exit 1
}

# Prints the generated policy (the `policy` field of the ldap-sync response) to stdout.
function _ldap_sync_generated_policy {
  local token=$1
  curl -sk -H "Authorization: Token token=\"${token}\"" \
    "https://localhost:${CONJUR_MASTER_PORT}/ldap-sync/policy?config_name=default" \
    | jq -er 'select(.ok == true) | .policy'
}

function _setup_ldap_sync() {
  local version
  version=$(_leader_appliance_version)
  if [[ -z "${version}" ]]; then
    echo "Cannot read the appliance version from conjur-master-1; run --provision-master first."
    exit 1
  fi

  _start_ldap_server
  _start_ldap_sync_service

  local token url="https://localhost:${CONJUR_MASTER_PORT}"
  token=$(_admin_token)

  echo "Loading the LDAP Sync configuration..."
  _ldap_curl "${token}" -X PATCH --data-binary @artifacts/ldap/sync-policy.yml "${url}/policies/demo/policy/root" > /dev/null

  echo "Storing the LDAP CA certificate and the bind password..."
  _ldap_curl "${token}" --data-binary @tmp/ldap-certs/ca-chain.cert.pem \
    "${url}/secrets/demo/variable/conjur%2Fldap-sync%2Ftls-ca-cert%2Fdefault" > /dev/null
  _ldap_curl "${token}" --data 'ldapsecret' \
    "${url}/secrets/demo/variable/conjur%2Fldap-sync%2Fbind-password%2Fdefault" > /dev/null

  echo "Generating the policy from the LDAP directory and loading it..."
  local imported
  imported=$(mktemp)
  if ! _ldap_sync_generated_policy "${token}" > "${imported}"; then
    rm -f "${imported}"
    echo "LDAP Sync could not generate the policy."
    exit 1
  fi
  _ldap_curl "${token}" -X POST --data-binary @"${imported}" "${url}/policies/demo/policy/root" > /dev/null
  rm -f "${imported}"

  echo "Checking: the LDAP users and groups exist in Conjur..."
  local missing=0 role status
  for role in user/alice user/bob user/charles group/devs group/qa group/all-staff; do
    status=$(_ldap_curl "${token}" -o /dev/null -w '%{http_code}' "${url}/roles/demo/${role}")
    if [[ "${status}" != "200" ]]; then
      echo "  missing: ${role} (HTTP ${status})"
      missing=1
    fi
  done
  if [[ ${missing} -ne 0 ]]; then
    echo "LDAP Sync check failed."
    exit 1
  fi

  cat << EOF

LDAP Sync is set up. The users and groups of the LDAP directory were imported into Conjur.

  Imported users:   alice, bob, charles
  Imported groups:  devs (alice), qa (alice), all-staff (alice)
  LDAP server:      ldaps://ldap-server:636   base dc=conjur,dc=net

Sync imports identities, it does not log anyone in. Imported users have no password until you set one
or enable an authenticator (see --provision-ldap-jit).

To run the sync again after changing the LDAP directory:
  bin/dap --provision-ldap-sync

The ldap-sync service is switched off in the appliance and runs until the leader restarts; running this command
starts it again.
EOF
}

# base64url, as JWTs use it: standard base64 with - and _ and no padding
function _base64url {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# Generates, once, into tmp/jwt: an RSA key and its public part as a JWK set (jwks.json). The key is kept, so that
# running the command again leaves the authenticator's key, and the tokens already issued, as they are.
function _jwt_generate_key {
  local out=./tmp/jwt
  if [[ -s "${out}/key.pem" && -s "${out}/jwks.json" ]]; then
    return
  fi
  echo "Generating the JWT signing key..."
  rm -rf "${out}"
  mkdir -p "${out}"
  openssl genrsa -out "${out}/key.pem" 2048 2> /dev/null
  local modulus
  modulus=$(openssl rsa -in "${out}/key.pem" -noout -modulus 2> /dev/null | sed 's/Modulus=//' | xxd -r -p | _base64url)
  jq -nc --arg n "${modulus}" '{keys:[{kty:"RSA",use:"sig",alg:"RS256",kid:"conjur-intro",n:$n,e:"AQAB"}]}' > "${out}/jwks.json"
}

# Prints a token for the host $1 (the value of the project_id claim), signed with the generated key and valid for an hour.
function _jwt_token {
  local project=$1 header payload signature
  header=$(jq -nc '{alg:"RS256",typ:"JWT",kid:"conjur-intro"}' | _base64url)
  payload=$(jq -nc --arg p "${project}" --argjson exp "$(( $(date +%s) + 3600 ))" \
    '{iss:"conjur-intro",project_id:$p,exp:$exp}' | _base64url)
  signature=$(printf '%s.%s' "${header}" "${payload}" | openssl dgst -sha256 -sign ./tmp/jwt/key.pem -binary | _base64url)
  printf '%s.%s.%s' "${header}" "${payload}" "${signature}"
}

# Prints the HTTP status of an authenticate request with the token $1.
function _jwt_authenticate_status {
  curl -sk -o /dev/null -w '%{http_code}' --data-urlencode "jwt=$1" \
    "https://localhost:${CONJUR_MASTER_PORT}/authn-jwt/intro/demo/authenticate"
}

function _setup_jwt() {
  local url="https://localhost:${CONJUR_MASTER_PORT}"

  # Check for a leader before anything is written, so that a failed run leaves no key behind
  if [[ -z "$(_leader_appliance_version)" ]]; then
    echo "Cannot read the appliance version from conjur-master-1; run --provision-master first."
    exit 1
  fi

  # Get the token first: with a leader that does not answer, the command stops here and leaves no key behind
  local token
  token=$(_admin_token)

  _jwt_generate_key

  echo "Loading the JWT authenticator policy..."
  _ldap_curl "${token}" -X PATCH --data-binary @artifacts/jwt/jwt-policy.yml "${url}/policies/demo/policy/root" > /dev/null

  echo "Storing the public key and the settings..."
  local prefix="conjur%2Fauthn-jwt%2Fintro"
  _ldap_curl "${token}" --data "{\"type\":\"jwks\",\"value\":$(cat tmp/jwt/jwks.json)}" \
    "${url}/secrets/demo/variable/${prefix}%2Fpublic-keys" > /dev/null
  _ldap_curl "${token}" --data "conjur-intro" "${url}/secrets/demo/variable/${prefix}%2Fissuer" > /dev/null
  _ldap_curl "${token}" --data "project_id" "${url}/secrets/demo/variable/${prefix}%2Ftoken-app-property" > /dev/null
  _ldap_curl "${token}" --data "jwt-apps" "${url}/secrets/demo/variable/${prefix}%2Fidentity-path" > /dev/null
  _ldap_curl "${token}" --data "jwt-secret-value" "${url}/secrets/demo/variable/jwt-secret" > /dev/null

  _append_conjur_authenticator "authn-jwt/intro"
  _sync_authenticators_to_other_nodes

  echo "Checking: myapp authenticates with a signed token and reads the secret; a token for a host it is not is refused..."
  local conjur_token status
  conjur_token=$(curl -sk -H "Accept-Encoding: base64" --data-urlencode "jwt=$(_jwt_token myapp)" \
    "${url}/authn-jwt/intro/demo/authenticate")
  status=$(_ldap_curl "${conjur_token}" -o /dev/null -w '%{http_code}' "${url}/secrets/demo/variable/jwt-secret")
  if [[ "${status}" != "200" ]]; then
    echo "JWT check failed: reading the secret with myapp's token returned HTTP ${status}."
    exit 1
  fi
  status=$(_jwt_authenticate_status "$(_jwt_token nobody)")
  if [[ "${status}" != "401" ]]; then
    echo "JWT check failed: a token for a host that does not exist returned HTTP ${status}, expected 401."
    exit 1
  fi

  cat << EOF

The JWT authenticator is set up (authn-jwt/intro). No token issuer runs: the public key is stored in Conjur.

  Hosts:      jwt-apps/myapp (can read the variable jwt-secret), jwt-apps/other (cannot)
  Key:        tmp/jwt/key.pem (private), tmp/jwt/jwks.json (public, stored in the variable public-keys)
  The host is chosen by the token's project_id claim.

Get a token for a host (valid for an hour) and authenticate with it:
  TOKEN=\$(bin/dap --jwt-token myapp)
  curl -k -H "Accept-Encoding: base64" --data-urlencode "jwt=\${TOKEN}" ${url}/authn-jwt/intro/demo/authenticate

Delete tmp/jwt to get a new key, then run the command again.
EOF
}

# bin/dap --jwt-token <host>: prints a signed token for the host, for the authenticator set up by --provision-jwt.
function _print_jwt_token {
  local project=$1
  if [[ -z "${project}" || ! -s ./tmp/jwt/key.pem ]]; then
    echo "Usage: bin/dap --jwt-token <host>, after bin/dap --provision-jwt (which generates the key)." >&2
    exit 1
  fi
  _jwt_token "${project}"
  echo
}

# Generates, once, into tmp/cert-auth: a CA, a client certificate it signed (URI SAN spiffe://trust.com/workload-id),
# and a second client certificate with the same name and SAN signed by a CA that Conjur is never given.
function _generate_cert_auth_certs {
  local out=./tmp/cert-auth
  if [[ -s "${out}/client.pem" && -s "${out}/untrusted-client.pem" ]]; then
    return
  fi
  echo "Generating the certificates..."
  rm -rf "${out}"
  mkdir -p "${out}"
  (
    cd "${out}"
    printf 'basicConstraints=CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=clientAuth\nsubjectAltName=URI:spiffe://trust.com/workload-id\n' > client.ext
    local name
    for name in trusted untrusted; do
      openssl genrsa -out "${name}-ca.key" 2048 2> /dev/null
      openssl req -x509 -new -key "${name}-ca.key" -sha256 -days 3650 -subj "/CN=Intro ${name} CA" \
        -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -out "${name}-ca.pem" 2> /dev/null
    done
    mv trusted-ca.pem ca.pem
    mv trusted-ca.key ca.key
    openssl genrsa -out client.key 2048 2> /dev/null
    openssl req -new -key client.key -subj "/CN=cert-client" -out client.csr 2> /dev/null
    openssl x509 -req -in client.csr -CA ca.pem -CAkey ca.key -CAcreateserial -days 825 -sha256 \
      -extfile client.ext -out client.pem 2> /dev/null
    openssl genrsa -out untrusted-client.key 2048 2> /dev/null
    openssl req -new -key untrusted-client.key -subj "/CN=cert-client" -out untrusted-client.csr 2> /dev/null
    openssl x509 -req -in untrusted-client.csr -CA untrusted-ca.pem -CAkey untrusted-ca.key -CAcreateserial \
      -days 825 -sha256 -extfile client.ext -out untrusted-client.pem 2> /dev/null
  )
}

# Authenticates host cert-client with a client certificate; prints the HTTP status.
# Usage: _cert_auth_status <certificate> <key>
function _cert_auth_status {
  curl -sk -o /dev/null -w '%{http_code}' --cert "$1" --key "$2" -X POST \
    "https://localhost:${CONJUR_MASTER_PORT}/authn-cert/intro/demo/host%2Fcert-client/authenticate"
}

function _setup_cert_auth() {
  local min_version=5.22.0 version
  version=$(_leader_appliance_version)
  if [[ -z "${version}" ]]; then
    echo "Cannot read the appliance version from conjur-master-1; run --provision-master first."
    exit 1
  fi
  if ! _version_at_least "${version}" "${min_version}"; then
    echo "Certificate authentication needs appliance ${min_version} or newer; this leader runs ${version}."
    exit 1
  fi

  # Get the token first: with a leader that does not answer, the command stops here and leaves no certificates behind
  local token url="https://localhost:${CONJUR_MASTER_PORT}"
  token=$(_admin_token)

  _generate_cert_auth_certs

  echo "Loading the certificate authenticator policy..."
  _ldap_curl "${token}" -X PATCH --data-binary @artifacts/cert-auth/cert-auth-policy.yml "${url}/policies/demo/policy/root" > /dev/null

  echo "Storing the CA certificate and a secret for the host..."
  _ldap_curl "${token}" --data-binary @tmp/cert-auth/ca.pem \
    "${url}/secrets/demo/variable/conjur%2Fauthn-cert%2Fintro%2Fca-cert" > /dev/null
  _ldap_curl "${token}" --data "cert-secret-value" "${url}/secrets/demo/variable/cert-secret" > /dev/null

  _append_conjur_authenticator "authn-cert/intro"
  _sync_authenticators_to_other_nodes

  echo "Checking: the host authenticates with its certificate, and a certificate from another CA is refused..."
  local status
  status=$(_cert_auth_status tmp/cert-auth/client.pem tmp/cert-auth/client.key)
  if [[ "${status}" != "200" ]]; then
    echo "Certificate authentication check failed: the trusted certificate returned HTTP ${status}."
    exit 1
  fi
  status=$(_cert_auth_status tmp/cert-auth/untrusted-client.pem tmp/cert-auth/untrusted-client.key)
  if [[ "${status}" != "401" ]]; then
    echo "Certificate authentication check failed: a certificate from an untrusted CA returned HTTP ${status}, expected 401."
    exit 1
  fi

  cat << EOF

Certificate authentication is set up (authenticator authn-cert/intro).

  Host:         cert-client (can read the variable cert-secret)
  Certificates: tmp/cert-auth/client.pem and client.key   (URI SAN spiffe://trust.com/workload-id, signed by tmp/cert-auth/ca.pem)
  Refused:      tmp/cert-auth/untrusted-client.pem        (same name and SAN, signed by a CA that Conjur does not trust)

Try it:
  curl -k --cert tmp/cert-auth/client.pem --key tmp/cert-auth/client.key -X POST \\
    ${url}/authn-cert/intro/demo/host%2Fcert-client/authenticate

Delete tmp/cert-auth to get new certificates.
EOF
}

# Names of the running nodes other than conjur-master-1 that can serve logins: standbys (for a failover) and the follower.
function _other_nodes {
  docker compose ps --format '{{.Service}}' 2> /dev/null \
    | grep -E '^conjur-(master-[2-9]|follower-[0-9]+)\.mycompany\.local$' | sort
}

# Waits until the node's own /health answers 200, up to about two minutes.
function _wait_for_node {
  local node=$1 i
  for i in $(seq 1 40); do
    if docker compose exec -T "${node}" curl -sk -m 5 -o /dev/null -w '%{http_code}' https://localhost/health 2> /dev/null | grep -q 200; then
      return 0
    fi
    sleep 3
  done
  echo "Warning: ${node} did not report healthy after the restart."
}

# Copies the leader's authenticator list, and the v1 OIDC flag if it has it, to every other running node and restarts
# its conjur service. CONJUR_AUTHENTICATORS is stored in each node's own conjur.conf, so a follower, a standby and a
# promoted standby reject the logins of an authenticator with "'...' is not enabled" until they have it too.
function _sync_authenticators_to_other_nodes {
  [[ $DRY_RUN = false ]] || return 0
  local nodes node list oidc_flag
  nodes=$(_other_nodes)
  [[ -n "${nodes}" ]] || return 0

  list=$(docker compose exec -T conjur-master-1.mycompany.local \
    bash -c "grep -E '^CONJUR_AUTHENTICATORS=' /opt/conjur/etc/conjur.conf" 2> /dev/null | tr -d '\r')
  [[ -n "${list}" ]] || return 0
  oidc_flag=false
  if docker compose exec -T conjur-master-1.mycompany.local \
      bash -c "grep -q '^CONJUR_FEATURE_OIDC_AUTHENTICATOR_V1_ENABLED=' /opt/conjur/etc/possum.conf" 2> /dev/null; then
    oidc_flag=true
  fi

  for node in ${nodes}; do
    echo "Enabling the authenticators on ${node}..."
    docker compose exec -T "${node}" bash -c "
      sed -i '/^CONJUR_AUTHENTICATORS=/d' /opt/conjur/etc/conjur.conf
      echo '${list}' >> /opt/conjur/etc/conjur.conf
      if [ '${oidc_flag}' = true ]; then
        grep -q '^CONJUR_FEATURE_OIDC_AUTHENTICATOR_V1_ENABLED=' /opt/conjur/etc/possum.conf \
          || echo 'CONJUR_FEATURE_OIDC_AUTHENTICATOR_V1_ENABLED=true' >> /opt/conjur/etc/possum.conf
      fi
      sv restart conjur
    " > /dev/null 2>&1 || echo "Warning: could not enable the authenticators on ${node}."
    _wait_for_node "${node}"
  done
}

# Installs Keycloak's certificate in the trust store of every other running node, so that they can validate tokens
# (OIDC) and fetch the signing keys (JWT) over TLS; --provision-keycloak does this on the leader.
function _trust_keycloak_on_other_nodes {
  [[ $DRY_RUN = false ]] || return 0
  local node
  for node in $(_other_nodes); do
    echo "Trusting the Keycloak certificate on ${node}..."
    docker compose cp artifacts/keycloak/fetch-certificate "${node}:/tmp/fetch-certificate" > /dev/null 2>&1 \
      && docker compose exec -T "${node}" bash -c 'chmod +x /tmp/fetch-certificate && /tmp/fetch-certificate' > /dev/null 2>&1 \
      || echo "Warning: could not install the Keycloak certificate on ${node}."
  done
}

function _single_master {
  _start_master
  _configure_master
  deploy_proxy
  echo "DAP instance available at: 'https://localhost:${CONJUR_MASTER_PORT}'"
  echo "Login using with the username/password: 'admin'/'$_admin_password'"
}

function _reload_container {
  name="$1"
  docker compose rm --stop --force $name
  docker compose up --no-deps --detach $name

}

function _setup_standbys {
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    _setup_standby "$i"
  done
  _start_standby_synchronization

  # Reload load balancer to serve cluster
  _set_master_multi_node_proxy_config
  _reload_container 'conjur-master.mycompany.local'
  _wait_for_master
}

function _command {
  docker run --rm -w /dap-intro -v "$(pwd):/dap-intro" alpine "$@"
}

function _stop {
  echo "stopping...."
  docker compose down -v
  docker network remove dap_net || true

  _command rm -rf cli_cache
  _command rm -rf system/backup
  _command rm -rf system/logs
  _command rm -rf system/haproxy/certs
  _command rm files/haproxy/master/haproxy.cfg || true
  _command rm kubeconfig || true
  echo "stopped"
  exit
}

function _cli {
  local _namespace=$1
  local _policy=$2

  echo "Loading Policy '$_policy':"
  cat $_policy
  echo ''
  echo "with command: 'conjur policy load -b $_namespace -f $_policy'"
  echo ''
  echo ''

  if [[ $DRY_RUN = false ]]; then
    bin/cli conjur policy load -b $_namespace -f $_policy
  fi
}

function _append_conjur_authenticator {
  authenticator=$1
  # Running a provision command twice must not list the authenticator twice.
  if [[ $DRY_RUN = false ]] && docker compose exec -T conjur-master-1.mycompany.local \
      bash -c "grep -E '^CONJUR_AUTHENTICATORS=' /opt/conjur/etc/conjur.conf | tr ',=' '\n\n' | grep -qxF '$authenticator'" 2> /dev/null; then
    echo "Authenticator ${authenticator} is already enabled."
    return
  fi
  if _run conjur-master-1.mycompany.local 'grep -q "CONJUR_AUTHENTICATORS" /opt/conjur/etc/conjur.conf'; then
    authenticator=$(echo $authenticator | sed 's/\//\\\//g')
    _run conjur-master-1.mycompany.local "sed -i 's/\(CONJUR_AUTHENTICATORS=.*\)/\1,$authenticator/' /opt/conjur/etc/conjur.conf"
  else
    _run conjur-master-1.mycompany.local "echo 'CONJUR_AUTHENTICATORS=authn,$authenticator' >> /opt/conjur/etc/conjur.conf"
  fi
  _run conjur-master-1.mycompany.local 'sv reload conjur'
  _wait_for_master
}

function _disable_autofailover {
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    _run "conjur-master-$i.mycompany.local" "evoke cluster member remove conjur-master-$i.mycompany.local"
  done
}

function _enable_autofailover {
  autofailover=$(curl -k https://${INTRO_MASTER_HOST:-localhost}:${CONJUR_MASTER_PORT}/info | jq .configuration.conjur.cluster_name)

  if [ "$autofailover" = 'production' ]; then
    for ((i=2; i<=STANDBY_COUNT+1; i++))
    do
      _run "conjur-master-$i.mycompany.local" "evoke cluster enroll --reenroll --cluster-machine-name conjur-master-$i.mycompany.local --master-name conjur-master-1.mycompany.local production"
    done
  else

    _wait_for_master

    _cli root "policy/base.yml"

    _set_cluster_policy_file
    _cli conjur/cluster policy/cluster.yml

    _run conjur-master-1.mycompany.local "evoke cluster enroll --cluster-machine-name conjur-master-1.mycompany.local production"
    for ((i=2; i<=STANDBY_COUNT+1; i++))
    do
      _run "conjur-master-$i.mycompany.local" "evoke cluster enroll --cluster-machine-name conjur-master-$i.mycompany.local --master-name conjur-master-1.mycompany.local production"
    done
  fi
}

_set_cluster_policy_file() {
  cat << EOF > policy/cluster.yml
- !policy
  id: production
  annotations:
    ttl: 30
  body:
    - !layer

    # Host nodes to be enrolled in the `production` auto-failover cluster
    - &hosts
      - !host conjur-master-1.mycompany.local
$(_standby_host_lines)

    - !grant
      role: !layer
      member: *hosts
EOF
}

_standby_host_lines() {
    declare -a standby_servers

  # The identifier for the Leader is 1, so we start at 2 for Standbys
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    standby_servers+=("      - !host conjur-master-$i.mycompany.local")
  done

  printf '%s' "$(IFS=$'\n' ; echo "${standby_servers[*]}")"
}

function _stop_replication {
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    if [[ $(docker ps --quiet --filter "name=conjur-master-$i.mycompany.local") ]]; then
      _run "conjur-master-$i.mycompany.local" "evoke replication stop"
    fi
  done
}

function _stop_and_rename {
  local container_name="$1"
  local rename_to="$2"
  docker compose stop $container_name
  image_id=$(docker ps --all --quiet --filter "name=$container_name")
  docker rename $image_id $rename_to
}

function _upgrade_via_backup_restore {
  upgrade_to="$1"

  autofailover=$(curl -k https://${INTRO_MASTER_HOST:-localhost}:${CONJUR_MASTER_PORT}/info | jq .configuration.conjur.cluster_name)

  if [ "$autofailover" = 'production' ]; then
    _disable_autofailover
  fi
  _upgrade_master_via_backup_restore $upgrade_to
}

function _stop_and_remove_master {
  docker compose rm --stop --force conjur-master-1.mycompany.local
}

function _restore_from_backup {
  _stop_and_remove_master
  _start_master

  # Unpack the backup with docker exec <container> evoke unpack backup -k /opt/conjur/backup/key /opt/conjur/backup/<yourbackupfile>
  _run conjur-master-1.mycompany.local 'evoke unpack backup --key /opt/conjur/backup/key /opt/conjur/backup/$(ls -1t /opt/conjur/backup | grep gpg | head -1)'

  # Configure the new master with docker exec <container> evoke restore master
  _run conjur-master-1.mycompany.local "evoke restore --accept-eula"

  # evoke restore re-runs the certificate recipe, which can regenerate the
  # external/internal certs (e.g. dual-CA migration, SAN mismatch after
  # restore). HAProxy validates backend certs against a snapshot copied at
  # provision time (see deploy_proxy) and won't see this change on its own,
  # so refresh the snapshot and reload haproxy to pick up the new CA/certs.
  mkdir -p ./system/haproxy/certs
  docker cp "$(docker compose ps -q conjur-master-1.mycompany.local)":/opt/conjur/etc/ssl/. ./system/haproxy/certs
  _reload_container 'conjur-master.mycompany.local'
}

function _upgrade_master_via_backup_restore {
  upgrade_to="$1"
  # Run evoke replication stop on existing standbys and followers
  _stop_replication

  # Generate a backup on the existing master using evoke backup
  _create_backup

  # Stop the existing master container with docker stop <container> and rename
  _stop_and_rename 'conjur-master-1.mycompany.local' 'conjur-master-1.mycompany.local_backup'

  # Start a container using the new version image (this will become the new master)
  export VERSION=$upgrade_to
  _restore_from_backup

  # Confirm master is healthy
  # ...
}

function _create_backup {
  _run conjur-master-1.mycompany.local \
    "evoke backup"
}

function _add_follower_proxy {
  _run conjur-follower-1.mycompany.local \
    "evoke proxy add 12.16.23.15"
}

function _trigger_master_failover_failover {
  docker compose kill conjur-master-1.mycompany.local
  echo 'Auto-failover takes about a minute to complete.'
}

function _reenroll_failed_leader {
  old_leader_number=$1
  new_leader_number=$2

  _run "conjur-master-$new_leader_number.mycompany.local" "evoke cluster member remove conjur-master-$old_leader_number.mycompany.local"
  docker compose rm --stop --force conjur-master-$old_leader_number.mycompany.local

  docker compose up --no-deps --detach "conjur-master-$old_leader_number.mycompany.local"

  # Generate a Seed File
  _run "conjur-master-$new_leader_number.mycompany.local" \
    "evoke seed standby conjur-master-$old_leader_number.mycompany.local conjur-master-$new_leader_number.mycompany.local > /opt/cyberark/dap/seeds/standby-seed-$old_leader_number.tar"

  # Unpack and Configure
  _run "conjur-master-$old_leader_number.mycompany.local" \
    "evoke unpack seed /opt/cyberark/dap/seeds/standby-seed-1.tar && evoke configure standby"

  _run "conjur-master-$new_leader_number.mycompany.local" \
    "evoke cluster member add conjur-master-$old_leader_number.mycompany.local"

  _run "conjur-master-$old_leader_number.mycompany.local" \
    "evoke cluster enroll --reenroll --cluster-machine-name conjur-master-$old_leader_number.mycompany.local --master-name conjur-master-$new_leader_number.mycompany.local production"

  _run "conjur-master-$new_leader_number.mycompany.local" \
    "evoke replication sync start"
}

function _import_certificates {
  bin/generate-certs

  local cert_path='/opt/cyberark/dap/configuration/certificates'
  _run conjur-master-1.mycompany.local \
    "evoke ca import --force --root $cert_path/ca-chain.pem"
  _run conjur-master-1.mycompany.local \
    "evoke ca import --force --key $cert_path/dap_master/dap-master-key.pem --set $cert_path/dap_master/dap-master.pem"
  _run conjur-master-1.mycompany.local \
    "evoke ca import --force --key $cert_path/dap_follower/dap-follower-key.pem $cert_path/dap_follower/dap-follower.pem"

  # HAProxy verifies backends against the CA snapshot taken in deploy_proxy,
  # so refresh it after the CA changes or every backend fails the TLS handshake.
  mkdir -p ./system/haproxy/certs
  docker cp "$(docker compose ps -q conjur-master-1.mycompany.local)":/opt/conjur/etc/ssl/. ./system/haproxy/certs
  _reload_container 'conjur-master.mycompany.local'
}

function _rotate_certificates {
  bin/generate-certs --rotate-server --force

  # Disable auto-failover while rotating the Master cluster certificates
  # to prevent an unintended failover.
  _pause_autofailover

  # Import the new certificate into the active DAP Master
  local cert_path='/opt/cyberark/dap/configuration/certificates'
  _run conjur-master-1.mycompany.local \
    "evoke ca import --force --key $cert_path/dap_master/dap-master-key.pem --set $cert_path/dap_master/dap-master.pem"

  # Import the new Follower certificate into the active DAP master so that it
  # is available through the seed service
  _run conjur-master-1.mycompany.local \
    "evoke ca import --force --key $cert_path/dap_follower/dap-follower-key.pem $cert_path/dap_follower/dap-follower.pem"

  # Import the new certificate into the DAP Standbys
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    if [[ $(docker ps --quiet --filter "name=conjur-master-$i.mycompany.local") ]]; then
      _run "conjur-master-$i.mycompany.local" \
        "evoke ca import --force --key $cert_path/dap_master/dap-master-key.pem --set $cert_path/dap_master/dap-master.pem"

      # Import the new Follower certificate into each DAP Standby so that it
      # is available through the seed service if the Standby is promoted.
      _run "conjur-master-$i.mycompany.local" \
        "evoke ca import --force --key $cert_path/dap_follower/dap-follower-key.pem $cert_path/dap_follower/dap-follower.pem"
    fi
  done

  # Re-enable auto-failover for the Master cluster
  _resume_autofailover

  if [[ $(docker ps --quiet --filter "name=conjur-follower-1.mycompany.local") ]]; then
    # Import the new certificate into each Follower
    _run conjur-follower-1.mycompany.local \
      "evoke ca import --force --key $cert_path/dap_follower/dap-follower-key.pem --set $cert_path/dap_follower/dap-follower.pem"
  fi
}

function _pause_autofailover {
  autofailover=$(curl -k https://${INTRO_MASTER_HOST:-localhost}:${CONJUR_MASTER_PORT}/info | jq -r .configuration.conjur.cluster_name)
  if [ "$autofailover" = 'production' ]; then
    for ((i=2; i<=STANDBY_COUNT+1; i++))
    do
      _run "conjur-master-$i.mycompany.local" "sv down cluster"
    done
  fi
}

function _resume_autofailover {
  autofailover=$(curl -k https://${INTRO_MASTER_HOST:-localhost}:${CONJUR_MASTER_PORT}/info | jq -r .configuration.conjur.cluster_name)
  if [ "$autofailover" = 'production' ]; then
    for ((i=2; i<=STANDBY_COUNT+1; i++))
    do
      _run "conjur-master-$i.mycompany.local" "sv up cluster"
    done
  fi
}

function _follower_to_master_connection {
  if [ "$1" == "on" ]; then
      local action="unpause"
  elif [ "$1" == "off" ]; then
      local action="pause"
  else
      echo "Invalid action. Use either 'on' or 'off'"
      exit 1
  fi

  docker container $action conjur-intro-conjur-master-1.mycompany.local-1
}

function _mke_enabled {
  # Returns 0 if MKE is enabled 1 otherwise
  docker compose exec conjur-master-1.mycompany.local bash -c "[ -f /secrets/master.key ]"
}

function _enable_mke {
  if _mke_enabled; then
    echo "MKE is already enabled. Exiting to avoid overwriting the existing master key."
    return 1
  fi
  echo "Enabling MKE"
  cat << EOF
    WARNING: MKE must be enabled after provisioning a leader but before
    provisioning any other nodes. Also it is currently only available for standard
    standbys/followers in conjur-intro.
EOF
  # Generate key file to be used for MKE
  _run conjur-master-1.mycompany.local "openssl rand 32 > /secrets/master.key"
  _run conjur-master-1.mycompany.local "cat /secrets/master.key | evoke keys encrypt -"
  _run conjur-master-1.mycompany.local "cat /secrets/master.key | evoke keys unlock -"
}

_standby_altnames() {

  declare -a standby_altnames

  # The identifier for the Leader is 1, so we start at 2 for Standbys
  for ((i=2; i<=STANDBY_COUNT+1; i++))
  do
    standby_altnames+=("conjur-master-$i.mycompany.local")
  done

  # Output the command delimited string
  echo "$(IFS=, ; echo "${standby_altnames[*]}")"
}

create_docker_network() {

  # Cleanup any old, unused networks, including the previous DAP Docker Compose
  # networks.
  docker network prune --force

  dap_net_pid=$(docker network ls --quiet --filter name=dap_net)
  if [[ -z "$dap_net_pid" ]]; then
    docker network create \
      --driver bridge \
      --ipam-driver default \
      --subnet 12.16.23.0/27 \
      dap_net
  fi
}

TAG=5.0-stable
K8S_FOLLOWER_TAG=edge
DRY_RUN=false
PULL_IMAGES=false
CMD=""
export DHPATH="${DHPATH:-/etc/ssl}"
STANDBY_COUNT=2

while true ; do
  case "$1" in
    --create-backup ) CMD='_create_backup' ; shift ;;
    --dry-run ) DRY_RUN=true ; shift ;;
    --enable-auto-failover ) CMD='_enable_autofailover' ; shift ;;
    --generate-dh ) export DHPATH=/tmp ; shift ;;
    -h | --help ) _print_help ; shift ;;
    --import-custom-certificates ) CMD='_import_certificates' ; shift ;;
    --promote-standby ) CMD='_perform_promotion' ; shift ;;
    --provision-follower ) CMD='_setup_follower' ; shift ;;
    --provision-k8s-follower ) CMD='_setup_k8s_follower' ; shift ;;
    --provision-csi-provider ) CMD='_setup_csi_provider' ; shift ;;
    --provision-secrets-provider ) CMD='_setup_secrets_provider' ; shift ;;
    --provision-secretless-broker ) CMD='_setup_secretless_broker' ; shift ;;
    --provision-master ) CMD='_single_master' ; shift ;;
    --enable-mke ) CMD="_enable_mke" ; shift ;;
    --provision-standbys ) CMD='_setup_standbys' ; shift ;;
    --provision-keycloak ) CMD='_setup_keycloak' ; shift ;;
    --provision-cert-auth ) CMD='_setup_cert_auth' ; shift ;;
    --provision-jwt ) CMD='_setup_jwt' ; shift ;;
    --jwt-token ) shift ; _print_jwt_token "$1" ; exit ;;
    --provision-ldap-jit ) CMD='_setup_ldap_jit' ; shift ;;
    --provision-ldap-sync ) CMD='_setup_ldap_sync' ; shift ;;
    --reenroll-failed-leader ) shift ; CMD="_reenroll_failed_leader $1 $2" ; shift ; shift ;;
    --restore-from-backup ) CMD='_restore_from_backup' ; shift ;;
    --rotate-custom-certificates ) CMD='_rotate_certificates' ; shift ;;
    --standby-count ) shift; STANDBY_COUNT=$1 ; shift ;;
    --stop ) _stop ; shift ;;
    --trigger-failover ) CMD='_trigger_master_failover_failover' ; shift ;;
    --trust-follower-proxy ) CMD='_add_follower_proxy' ; shift ;;
    --upgrade-master ) shift ; CMD="_upgrade_via_backup_restore $1" ; shift ;;
    --version ) shift ; TAG=$1 ; shift ;;
    --k8s-follower-version ) shift ; K8S_FOLLOWER_TAG=$1 ; shift ;;
    --wait-for-master ) CMD='_wait_for_master' ; shift ;;
    --follower-to-master-connection ) shift ; CMD="_follower_to_master_connection $1" ; shift ;;
     * ) if [ -z "$1" ]; then break; else echo "$1 is not a valid option"; exit 1; fi;;
  esac
done

export VERSION=$TAG

create_docker_network

eval $CMD
